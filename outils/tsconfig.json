{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@duo/config/tsconfig.node.json",
  "compilerOptions": {
    // Les scripts restent en JavaScript (lancés par Node sans étape de construction), vérifiés par TypeScript.
    "allowJs": true,
    "checkJs": true,
    // `@duo/paquet` expose ses sources avec des imports en `.ts` (exécutables par Node tels quels).
    "allowImportingTsExtensions": true
  },
  "include": ["*.mjs", "*.ts", "tests"]
}
