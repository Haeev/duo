{"format":"tdb-lieu/1","id":"aubrune","nom":"Aubrune","taille":{"largeur":384,"hauteur":208},"vitesses":{"marche":3,"course":5,"draisine":8},"zones":[{"id":"B","nom":"Le bourg et le passage à niveau","acte":1,"contour":[[146,100.5],[164,100.5],[164,90],[162,82],[236,82],[236,63],[296,63],[296,100],[318,100],[318,138.5],[286,132.5],[248,129.5],[206.5,129.5],[206.5,132],[201.5,132],[201.5,129.5],[174,130.5],[174,125],[146,126.5]]},{"id":"R","nom":"La rivière et le bief","acte":2,"contour":[[0,140],[26,136],[34,137],[116,130.5],[130,125.5],[134,126],[142,126],[146,126.5],[174,125],[174,130.5],[201.5,129.5],[201.5,132],[206.5,132],[206.5,129.5],[248,129.5],[286,132.5],[322,139.5],[354,151.5],[384,157.5],[384,166.5],[354,160.5],[322,148.5],[286,141.5],[248,138.5],[204,138.5],[160,140.5],[130,147.5],[118,151.5],[84,155],[36,156.5],[0,160.5]]},{"id":"V","nom":"La voie jusqu'au poste d'aiguillage","acte":2,"contour":[[20,88],[47,88],[47,94],[55,94],[55,84],[100,84],[100,94.5],[164,94.5],[164,100.5],[100,100.5],[100,104],[55,104],[55,100.5],[47,100.5],[47,104],[34,104],[34,110],[40,118],[40,134],[34,137],[26,136],[30,110],[30,104],[20,104]]},{"id":"C","nom":"La Côte","acte":3,"contour":[[100,0],[314,0],[314,63],[236,63],[236,82],[162,82],[164,90],[100,89.4]]},{"id":"M","nom":"Le moulin","acte":3,"contour":[[122,102],[146,100.5],[146,126.5],[142,126],[134,126],[130,125.5],[116,130.5],[110,110]]},{"id":"F","nom":"La ferme","acte":3,"contour":[[130,147.5],[160,140.5],[204,138.5],[248,138.5],[286,141.5],[322,148.5],[334,153],[334,204],[130,204]]},{"id":"T","nom":"Le tunnel","acte":3,"contour":[[296,66],[336,66],[350,56],[360,50],[360,32],[352,32],[352,40],[314,40],[314,18],[352,18],[352,28],[360,28],[360,12],[368,12],[368,52],[376,60],[384,62],[384,100],[296,100]]}],"elements":[{"calque":"batiments","sorte":"Bâtiment","nom":"Le quai","texte":"Le coeur: le train s'arrête là, la caisse de la commande, le tableau, la cloche et la pendule y sont. Pour: tous.","acte":1,"rect":[185,99,30,4],"x":200,"y":101},{"calque":"batiments","sorte":"Bâtiment","nom":"La halte","texte":"Au bout est du quai, en ligne avec lui; porte au sud, sur la Grand-Route, là où arrivent les voyageurs à pied. Pour: Firmin (bureau), consigne.","acte":1,"rect":[215,99,10,6],"x":220,"y":102},{"calque":"batiments","sorte":"Bâtiment","nom":"La maison du garde-barrière","texte":"Au passage à niveau; porte à l'est, vers la route: le garde sort et il est à sa barrière en dix pas. Emprise de la maison finie (88 m²), la ruine du début n'en occupe que la moitié est. Pour: les deux joueurs.","acte":1,"rect":[168,111,11,8],"x":173.5,"y":115},{"calque":"batiments","sorte":"Bâtiment","nom":"L'épicerie-pension Ferrand","texte":"Borde la place à l'ouest, vitrine et porte vers la place: on la voit en descendant du quai. Pour: Odette.","acte":1,"rect":[186,111,8,10],"x":190,"y":116},{"calque":"batiments","sorte":"Bâtiment","nom":"L'atelier de Basile","texte":"Contre le bois, au départ du chemin forestier: les grumes descendent et s'arrêtent là; porte et auvent à l'est, vers le chemin. Pour: Basile.","acte":1,"rect":[166,84,10,8],"x":171,"y":88},{"calque":"batiments","sorte":"Bâtiment","nom":"La maison de Firmin","texte":"En face du quai, de l'autre côté de la voie: il traverse par la traversée de service. Pour: Firmin.","acte":1,"rect":[205,84,7,6],"x":208.5,"y":87},{"calque":"batiments","sorte":"Bâtiment","nom":"La remise de la draisine","texte":"Sur sa courte voie, porte à l'ouest dans l'axe des rails: la draisine sort droit sur la ligne (déplacée: l'ancienne avait sa porte au sud, sans rail devant). Pour: draisine.","acte":2,"rect":[220,90,6,5],"x":223,"y":92.5},{"calque":"batiments","sorte":"Bâtiment","nom":"Le fournil d'Achille","texte":"Sur la Grand-Route juste après le pont du ru: l'eau du pétrin est à sa porte. Pour: Achille.","acte":1,"rect":[229,100,7,6],"x":232.5,"y":103},{"calque":"batiments","sorte":"Bâtiment","nom":"La mercerie-coiffure","texte":"En face du fournil; porte au nord, sur la rue. Pour: Solange, Jeanne.","acte":1,"rect":[232,111,7,7],"x":235.5,"y":114.5},{"calque":"batiments","sorte":"Bâtiment","nom":"L'école-mairie","texte":"Au milieu du bourg, sa cour à l'ouest, entre le fournil et le café. Pour: Armand (acte 2).","acte":2,"rect":[244,100,7,6],"x":247.5,"y":103},{"calque":"batiments","sorte":"Bâtiment","nom":"La maison de Lucie","texte":"En face de l'école, porte au nord sur la rue; la boîte aux lettres du bourg est à sa grille. Pour: Lucie (acte 2).","acte":2,"rect":[243,111,6,6],"x":246,"y":114},{"calque":"batiments","sorte":"Bâtiment","nom":"Le café de la Halte","texte":"Au carrefour de l'Église, terrasse et jeu de quilles au sud, côté soleil. Pour: Colette (acte 2).","acte":2,"rect":[251,100,7,6],"x":254.5,"y":103},{"calque":"batiments","sorte":"Bâtiment","nom":"La forge","texte":"Sur la Grand-Route, où passent les charrettes, à l'écart des maisons pour le bruit et le feu. Pour: Mado, Barnabé (acte 3).","acte":1,"rect":[263,100,6,6],"x":266,"y":103},{"calque":"batiments","sorte":"Bâtiment","nom":"L'atelier d'Ambroise","texte":"Ancienne menuiserie de la carte 0.13, reprise pour l'ancien régleur: à l'autre bout de la rue par rapport à la halte, il ne croise pas Firmin. Pour: Ambroise.","acte":1,"rect":[272,100,7,6],"x":275.5,"y":103},{"calque":"batiments","sorte":"Bâtiment","nom":"La maison d'Honorine","texte":"Dernière maison avant le passage des Hameaux: de sa fenêtre elle voit la voie, c'est le témoin de la nuit de la fermeture. Pour: Honorine.","acte":1,"rect":[282,100,6,6],"x":285,"y":103},{"calque":"batiments","sorte":"Bâtiment","nom":"La maison aux volets clos","texte":"Une maison vide donne un habitant à accueillir plus tard. Pour: réserve (Nour, après la fin).","acte":4,"rect":[294,100,6,6],"x":297,"y":103},{"calque":"batiments","sorte":"Bâtiment","nom":"La maison du bout","texte":"Destinataire d'une lettre en retard. Pour: réserve (suite des lettres).","acte":2,"rect":[292,111,6,6],"x":295,"y":114},{"calque":"batiments","sorte":"Bâtiment","nom":"L'église Saint-Aubin","texte":"Sur le coteau, hors des crues, au bout de la rue de l'Église; portail au sud, sur le parvis; le clocher est à l'ouest de la nef. Pour: Marthe (clocher).","acte":1,"rect":[249,67,21,12],"x":259.5,"y":73},{"calque":"batiments","sorte":"Bâtiment","nom":"Le presbytère","texte":"Contre l'église, porte à l'est sur le parvis. Pour: Martial (après la fin).","acte":4,"rect":[240,79,7,7],"x":243.5,"y":82.5},{"calque":"batiments","sorte":"Bâtiment","nom":"La maison de Marthe","texte":"Maison de la sonneuse, au pied du parvis, porte à l'est sur la rue de l'Église. Pour: Marthe.","acte":1,"rect":[251,87,6,6],"x":254,"y":90},{"calque":"batiments","sorte":"Bâtiment","nom":"La maison de cheminot (ouest)","texte":"Logements de la Compagnie près du passage à niveau; portes au nord, sur le chemin du Moulin. Pour: réserve (Inès, après la fin).","acte":4,"rect":[150,110,6,6],"x":153,"y":113},{"calque":"batiments","sorte":"Bâtiment","nom":"La maison de cheminot (est)","texte":"Voisine de la précédente. Pour: Barnabé avant son mariage: grenier (fanfare).","acte":2,"rect":[158,110,6,6],"x":161,"y":113},{"calque":"batiments","sorte":"Bâtiment","nom":"Le lavoir","texte":"Sur une dérivation du ru (eau claire), entre la halte, la place et la berge. Ouvert à l'OUEST, côté chemin: on y entre à pied sec; le bassin est côté ru. L'ancien s'ouvrait sur la rivière et n'était pas accessible. Pour: tous (Armand et ses grenouilles).","acte":1,"rect":[221,114,5,4],"x":223.5,"y":116},{"calque":"batiments","sorte":"Bâtiment","nom":"Le poste d'aiguillage","texte":"Au droit de l'aiguille de la voie de garage; porte au nord, face à la voie, cabine vitrée à l'étage d'où l'on voit le signal. Pour: personne (scène des leviers).","acte":2,"rect":[36,101,6,4],"x":39,"y":103},{"calque":"batiments","sorte":"Bâtiment","nom":"Le moulin de la Vanne","texte":"Au bout du bief; la roue est sur le pignon sud, dans le bief; la porte au nord, sur la cour où s'arrêtent les charrettes. Pour: Berthe (acte 3).","acte":3,"rect":[134,118,8,8],"x":138,"y":122},{"calque":"batiments","sorte":"Bâtiment","nom":"Le logis de la ferme Delmas","texte":"Sur la rive sud, hors du bourg, façade et porte au midi sur la cour (déplacée: l'ancienne ferme était serrée entre la route et la rivière, sans champs à elle). Pour: Paulin, Margot, Léon (acte 3).","acte":3,"rect":[200,147,9,6],"x":204.5,"y":150},{"calque":"batiments","sorte":"Bâtiment","nom":"La grange","texte":"Ferme la cour à l'ouest (vents de pluie), porte charretière à l'est sur la cour. Pour: les Delmas.","acte":3,"rect":[184,162,8,10],"x":188,"y":167},{"calque":"batiments","sorte":"Bâtiment","nom":"La maison forestière","texte":"Au bout carrossable du chemin forestier, porte à l'est sur le chemin. Pour: réserve (Inès, après la fin).","acte":4,"rect":[126,42,6,6],"x":129,"y":45},{"calque":"batiments","sorte":"Repère","nom":"Le clocher","texte":"Repère du nord-est: visible de la place, de la berge et de la ferme; sa cloche donne l'heure. Hauteur: 22 m.","acte":null,"x":252,"y":73},{"calque":"batiments","sorte":"Repère","nom":"Le château d'eau de la halte","texte":"Repère du centre: réservoir des locomotives, au nord du quai; où qu'on soit dans le bourg, il dit où est le quai; posé au nord du chemin de la Lisière, hors du chemin. Hauteur: 12 m.","acte":null,"x":189,"y":87},{"calque":"batiments","sorte":"Repère","nom":"Le sémaphore","texte":"Repère de l'ouest: on le voit au bout de la tranchée dès qu'on a coupé les ronces; c'est lui qu'il faut faire bouger. Hauteur: 10 m.","acte":null,"x":30,"y":94.5},{"calque":"batiments","sorte":"Repère","nom":"La roue du moulin","texte":"Repère du sud-ouest: vue depuis l'île et depuis le chemin du Moulin, immobile jusqu'à l'acte 3. Hauteur: 7 m.","acte":null,"x":138,"y":127.6},{"calque":"batiments","sorte":"Repère","nom":"Le Vieux Chêne","texte":"Repère de la Côte: sa tête dépasse du bois, on le voit depuis la lisière. Hauteur: 18 m.","acte":null,"x":188,"y":47},{"calque":"batiments","sorte":"Repère","nom":"Le portail du tunnel","texte":"Repère de l'est: une bouche noire au bout de la courbe, visible dès la grille. Hauteur: 8 m.","acte":null,"x":362,"y":50.5},{"calque":"batiments","sorte":"Repère","nom":"Le Gros Noyer","texte":"Repère du sud: seul sur sa butte au milieu des prés, il oriente le tour de la ferme; à 5 m du tour de la ferme, sur sa butte. Hauteur: 16 m.","acte":null,"x":161,"y":187},{"calque":"batiments","sorte":"Repère","nom":"Le pigeonnier de la ferme","texte":"Vu depuis le ponton par-dessus la rivière: donne envie de passer le gué bien avant qu'il soit refait; à l'angle est du logis, hors du chemin des Champs. Hauteur: 10 m.","acte":null,"x":213,"y":150.5},{"calque":"batiments","sorte":"Eau","nom":"L'étang de la Côte","texte":"Retenue du ru derrière une petite digue (au sud), faite pour abreuver les bêtes du Haut; le ru en ressort par la bonde.","acte":null,"x":236,"y":40,"r":9},{"calque":"chemins","sorte":"Ouvrage","nom":"Passage à niveau","texte":"Gardé: deux lisses qui barrent la route (et non la voie), manoeuvrées depuis la maison du garde.","acte":null,"x":182.5,"y":97.5,"r":3},{"calque":"chemins","sorte":"Ouvrage","nom":"Traversée","texte":"Platelage de planches au bout du quai: Firmin traverse là chaque matin.","acte":null,"x":214,"y":96,"r":4},{"calque":"chemins","sorte":"Ouvrage","nom":"Passage à niveau","texte":"La rue de l'Église existait avant la voie: simple croix de Saint-André.","acte":null,"x":259.5,"y":97.5,"r":3},{"calque":"chemins","sorte":"Ouvrage","nom":"Passage à niveau","texte":"Accès de service à la voie, dernier point avant la grille de la Compagnie.","acte":null,"x":291.5,"y":97.5,"r":3},{"calque":"chemins","sorte":"Ouvrage","nom":"Ponceau","texte":"Voûte de pierre: le ru passe sous le remblai de la voie.","acte":null,"x":228,"y":97.5,"r":3},{"calque":"chemins","sorte":"Ouvrage","nom":"Pont","texte":"Pont de pierre de la Grand-Route, 3 m entre parapets.","acte":null,"x":228,"y":108,"r":3},{"calque":"chemins","sorte":"Ouvrage","nom":"Passerelle","texte":"Planches du chemin de la Berge sur le ru, juste avant son embouchure.","acte":null,"x":228,"y":126,"r":3},{"calque":"chemins","sorte":"Ouvrage","nom":"Ponton","texte":"Dans l'axe de la place: on le voit depuis le puits.","acte":null,"x":204,"y":130.2,"r":3},{"calque":"chemins","sorte":"Ouvrage","nom":"Gué","texte":"Dans l'axe de la route du passage à niveau: la vieille route passait là avant tout pont.","acte":null,"x":182.5,"y":135,"r":6},{"calque":"chemins","sorte":"Ouvrage","nom":"Planches","texte":"Deux madriers sur le canal de fuite: le seul accès à pied sec à l'île du Bief.","acte":null,"x":146,"y":131,"r":3},{"calque":"chemins","sorte":"Ouvrage","nom":"Passerelle","texte":"Passerelle du meunier pour aller manoeuvrer la vanne.","acte":null,"x":34.5,"y":142,"r":3},{"calque":"chemins","sorte":"Ouvrage","nom":"Digue","texte":"On passe sur la digue de l'étang, au-dessus de la bonde.","acte":null,"x":231.5,"y":49.7,"r":3},{"calque":"chemins","sorte":"Ouvrage","nom":"Passerelle","texte":"Relie les champs de la ferme au bout de la Grand-Route: le raccourci du retour.","acte":null,"x":316,"y":142.8,"r":6},{"calque":"chemins","sorte":"Ouvrage","nom":"Déversoir","texte":"Seuil de pierre en travers de l'Aubrune, qui relève l'eau pour le bief (non franchissable).","acte":null,"x":20,"y":152,"r":3},{"calque":"verrous","sorte":"Verrou V1","nom":"Le saule couché en travers du chemin de la berge","texte":"Levé quand: Achille le fait débiter le jour de la leçon de pêche (acte 2). En jeu: « Le vieux saule barre le chemin. Pas encore: il faudra une scie, et quelqu'un qui sait par où couper. »","acte":2,"x":174,"y":127},{"calque":"verrous","sorte":"Verrou V2","nom":"Les ronces de la tranchée, sur la voie","texte":"Levé quand: Firmin donne le but « voie dégagée » (acte 2); hache de base. En jeu: « Les ronces ont avalé la voie. Pas encore: Firmin a dit d'attendre son signal. »","acte":2,"x":170,"y":97.5},{"calque":"verrous","sorte":"Verrou V2b","nom":"Trois frênes couchés en travers de l'étranglement du poste, sur la ligne, trop gros pour la hache de base","texte":"Levé quand: Hache améliorée par Mado (acte 2): on bute, on revient avec l'outil. En jeu: « Trois frênes en travers des rails, d'un talus à l'autre. Pas encore: ta hache rebondit sur l'écorce. »","acte":2,"x":51,"y":97.5},{"calque":"verrous","sorte":"Verrou V3","nom":"Le gué emporté par la dernière crue (trois dalles manquent)","texte":"Levé quand: Paulin Delmas remet les dalles en arrivant par le train (acte 3). En jeu: « Trois dalles du gué ont filé avec la crue. Pas encore: l'eau est trop vive pour sauter. »","acte":3,"x":182.5,"y":135},{"calque":"verrous","sorte":"Verrou V4","nom":"Le portail de la cour du moulin, cadenassé, et le portillon de la berge","texte":"Levé quand: Berthe arrive avec la clé (acte 3). En jeu: « Le portail du moulin est cadenassé. Pas encore: la clé est partie avec le meunier. »","acte":3,"x":144,"y":110},{"calque":"verrous","sorte":"Verrou V5","nom":"La barrière forestière de Basile (« coupe en cours »)","texte":"Levé quand: Basile vous envoie au bois pour la chambre (acte 3). En jeu: « « Coupe en cours, défense d'entrer. » Pas encore: Basile t'emmènera quand ce sera le moment. »","acte":3,"x":182.5,"y":83},{"calque":"verrous","sorte":"Verrou V6","nom":"Le raidillon du ru, raviné","texte":"Levé quand: Basile y pose trois rondins en marches (acte 3). En jeu: « Le raidillon s'est raviné, la terre s'effrite sous ton pied. Pas encore: il faudrait des marches. »","acte":3,"x":220,"y":79},{"calque":"verrous","sorte":"Verrou V7","nom":"La porte haute du cimetière, fermée à clé","texte":"Levé quand: Marthe prête la clé (acte 3, la coutume). En jeu: « La porte haute du cimetière est fermée à clé. Pas encore: c'est Marthe qui a la clé. »","acte":3,"x":281,"y":63.5},{"calque":"verrous","sorte":"Verrou V8","nom":"La grille de la Compagnie en travers de la voie (« Ligne fermée »)","texte":"Levé quand: Firmin sort enfin la clé avec la lettre (acte 3); Jeanne connaît un trou, trop petit pour vous. En jeu: « « Ligne fermée. Compagnie des chemins de fer. » Pas encore: la grille ne bouge pas d'un pouce. »","acte":3,"x":298,"y":97.5},{"calque":"verrous","sorte":"Verrou V9","nom":"La passerelle des Jardins, sans tablier","texte":"Levé quand: Les planches viennent de la ferme: raccourci ouvert depuis la rive sud (acte 3). En jeu: « Il ne reste que les poutres de la passerelle. Pas encore: il manque les planches. »","acte":3,"x":316,"y":142.8},{"calque":"verrous","sorte":"Verrou V10","nom":"L'escalier de service du tunnel, verrouillé de l'intérieur","texte":"Levé quand: On tire le verrou depuis le tunnel: raccourci vers le belvédère (acte 3). En jeu: « La porte de l'escalier est fermée d'une chaîne, de l'autre côté. Pas encore: elle s'ouvre d'en bas. »","acte":3,"x":356,"y":30},{"calque":"verrous","sorte":"Verrou V11","nom":"Le portillon du poste, fermé d'un loquet côté voie","texte":"Levé quand: On l'ouvre depuis le poste: raccourci vers la vanne et le retour par la berge (acte 2). En jeu: « Le portillon est fermé d'un loquet, côté voie. Pas encore: il s'ouvre depuis le poste. »","acte":2,"x":31.2,"y":104.5},{"calque":"ressources","sorte":"Ressource (peche)","nom":"Peche ponton","texte":"Eau calme sous le ponton, poissons blancs. Heures: toutes.","acte":2,"x":204,"y":131.5},{"calque":"ressources","sorte":"Ressource (peche)","nom":"Peche aval","texte":"Courant de l'aval: truites au lever et au coucher. Heures: matin et soir.","acte":2,"x":295,"y":134},{"calque":"ressources","sorte":"Ressource (peche)","nom":"Peche fosse","texte":"La fosse de la Baronne, sous la roue. Heures: toutes.","acte":2,"x":132,"y":131.4},{"calque":"ressources","sorte":"Ressource (peche)","nom":"Peche saule ile","texte":"À l'ombre du saule têtard. Heures: jour.","acte":2,"x":78,"y":138.4},{"calque":"ressources","sorte":"Ressource (peche)","nom":"Peche vanne","texte":"L'eau qui tombe du déversoir: ricochets et brochets. Heures: toutes. Saisons: printemps, été, automne.","acte":2,"x":24,"y":146},{"calque":"ressources","sorte":"Ressource (peche)","nom":"Peche etang","texte":"L'étang de la Côte, carpes et tanches. Heures: toutes.","acte":3,"x":227,"y":39},{"calque":"ressources","sorte":"Ressource (culture)","nom":"Terre 6","texte":"Le potager de départ (6 cases du jeu), au bout de l'allée du jardin.","acte":1,"x":174,"y":122.5,"rect":[171,120.5,6,4]},{"calque":"ressources","sorte":"Ressource (culture)","nom":"Terre 12","texte":"Agrandi à 12 cases après la toiture, vers l'ouest.","acte":1,"x":172,"y":122.5,"rect":[166,120.5,12,4]},{"calque":"ressources","sorte":"Ressource (culture)","nom":"Terre 24","texte":"24 cases à l'acte 2: le jardin entier au sud de la maison et de son allée, le poulailler à l'ouest.","acte":2,"x":172,"y":123,"rect":[166,120.5,12,5]},{"calque":"ressources","sorte":"Ressource (culture)","nom":"Champs location","texte":"Les champs des Delmas, loués par parcelles.","acte":3,"x":238,"y":177,"rect":[214,164,48,26]},{"calque":"ressources","sorte":"Ressource (cueillette)","nom":"Mures tranchee","texte":"Les ronces des talus. Heures: jour. Saisons: été, automne.","acte":2,"x":146,"y":100.2},{"calque":"ressources","sorte":"Ressource (cueillette)","nom":"Chataignes","texte":"Châtaigniers du bas de la Côte, 3 m au sud des troncs (houppier). Heures: jour. Saisons: automne.","acte":3,"x":176,"y":72},{"calque":"ressources","sorte":"Ressource (cueillette)","nom":"Champignons","texte":"Sous-bois humide, le matin après la pluie. Heures: matin. Saisons: automne.","acte":3,"x":176,"y":25},{"calque":"ressources","sorte":"Ressource (cueillette)","nom":"Myrtilles","texte":"La lande de la crête. Heures: jour. Saisons: été.","acte":3,"x":152,"y":17},{"calque":"ressources","sorte":"Ressource (cueillette)","nom":"Noix","texte":"Sous le Gros Noyer. Heures: jour. Saisons: automne.","acte":3,"x":162,"y":184},{"calque":"ressources","sorte":"Ressource 