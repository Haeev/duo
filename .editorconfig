# Mise en forme commune à tous les éditeurs (macOS, Windows, Linux).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Deux espaces en fin de ligne y forcent un retour à la ligne.
[*.md]
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[{Makefile,*.mk}]
indent_style = tab

[*.{cmd,bat}]
end_of_line = crlf
