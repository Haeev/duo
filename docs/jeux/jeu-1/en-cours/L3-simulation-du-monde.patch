+    send(sim, id, { type: 'menu', menu: 'salon' });
+  }
+
+  it('15 coupes, 8 couleurs, 4 barbes; 15, 10 et 20 sous; « Garder ma coiffure » gratuit; un seul au fauteuil', () => {
