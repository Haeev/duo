+        {"id": "ac_d7", "kind": "daily", "priority": 1, "when": [], "lines": [{"speaker": "achille", "text": "Mon grand-père a bâti ce four. Il tient encore, à quelques fissures près. Comme moi."}]},
+        {"id": "ac_d8", "kind": "daily", "priority": 1, "when": [], "lines": [{"speaker": "achille", "text": "La farine arrive par le train du samedi. Le reste de la semaine, je compte les sacs."}]},
+        {"id": "ac_d9", "kind": "daily", "priority": 1, "when": [], "lines": [{"speaker": "achille", "text": "Un bon pain, c'est de la farine, de l'eau, du sel et du temps. Le temps, c'est le plus cher."}]},
+        {"id": "ac_d10", "kind": "daily", "priority": 1, "when": [], "lines": [{"speaker": "achille", "text": "Après midi, ne frappez pas au fournil: je dors. Le soir, je suis au gué, avec ma canne."}]},
+        {"id": "ac_pr1", "kind": "daily", "priority": 1, "when": [{"type": "season_is", "seasons": ["spring"]}], "lines": [{"speaker": "achille", "text": "Au printemps, la pâte lève plus vite. Tout le monde se réveille, même elle."}]},
+        {"id": "ac_pr2", "kind": "daily", "priority": 1, "when": [{"type": "season_is", "seasons": ["spring"]}], "lines": [{"speaker": "achille", "text": "Les pissenlits du talus, je les mange avec un croûton. Ne le dites pas à Odette, elle me les vendrait."}]},
+        {"id": "ac_pr3", "kind": "daily", "priority": 1, "when": [{"type": "season_is", "seasons": ["spring"]}], "lines": [{"speaker": "achille", "text": "Les jours rallongent: je fais ma fournée à la lanterne et je la sors au soleil."}]},
+        {"id": "ac_pr4", "kind": "daily", "priority": 1, "when": [{"type": "season_is", "seasons": ["spring"]}], "lines": [{"speaker": "achille", "text": "Au printemps, je fais un pain aux herbes. L'ail des ours, ça réveille."}]},
+        {"id": "ac_et1", "kind": "daily", "priority": 1, "when": [{"type": "season_is", "seasons": ["summer"]}], "lines": [{"speaker": "achille", "text": "L'été, le fournil est un four lui-même. Je travaille en tricot de corps et je ne regrette rien."}]},
+        {"id": "ac_et2", "kind": "daily", "priority": 1, "when": [{"type": "season_is", "seasons": ["summer"]}], "lines": [{"speaker": "achille", "text": "Il fait si chaud que la pâte lève toute seule. Je n'ai plus qu'à la regarder."}]},
+        {"id": "ac_et3", "kind": "daily", "priority": 1, "when": [{"type": "season_is", "seasons": ["summer"]}], "lines": [{"speaker": "achille", "text": "Les soirs d'été, le gué est plein de truites qui se moquent de moi."}]},
+        {"id": "ac_et4", "kind": "daily", "priority": 1, "when": [{"type": "season_is", "seasons": ["summer"]}], "lines": [{"speaker": "achille", "text": "En été, je cuis plus tôt encore, pour finir avant que le soleil cogne."}]},
+        {"id": "ac_au1", "kind": "daily", "priority": 1, "when": [{"type": "season_is", "seasons": ["autumn"]}], "lines": [{"speaker": "achille", "text": "Les noisettes de la Côte, dans une miche, c'est un pain de fête. Vous en avez, des noisettes ?"}]},
+        {"id": "ac_au2", "kind": "daily", "priority": 1, "when": [{"type": "season_is", "seasons": ["autumn"]}], "lines": [{"speaker": "achille", "text": "L'automne, c'est la saison du pain de seigle. Il dure une semaine, comme les bonnes nouvelles."}]},
+        {"id": "ac_au3", "kind": "daily", "priority": 1, "when": [{"type": "season_is", "seasons": ["autumn"]}], "lines": [{"speaker": "achille", "text": "Le matin, la brume sent le levain. Ou c'est moi."}]},
+        {"id": "ac_au4", "kind": "daily", "priority": 1, "when": [{"type": "season_is", "seasons": ["autumn"]}], "lines": [{"speaker": "achille", "text": "Jeanne passe au guichet avant l'école. Elle prend un quignon et elle file."}]},
+        {"id": "ac_pl1", "kind": "daily", "priority": 5, "when": [{"type": "weather_is", "weather": "rain"}], "lines": [{"speaker": "achille", "text": "Il pleut ? Tant mieux. Le four garde sa chaleur, et moi j'ai une excuse pour rester près de lui."}]},
+        {"id": "ac_pl2", "kind": "daily", "priority": 5, "when": [{"type": "weather_is", "weather": "rain"}], "lines": [{"speaker": "achille", "text": "La pluie ramollit les croûtes. Mangez vite, ou mangez à l'abri."}]},
+        {"id": "ac_pl3", "kind": "daily", "priority": 5, "when": [{"type": "weather_is", "weather": "rain"}], "lines": [{"speaker": "achille", "text": "Les jours de pluie, je ne pêche pas: je regarde la rivière par la fenêtre et je compte les ronds."}]}
