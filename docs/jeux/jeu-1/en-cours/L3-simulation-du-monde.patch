+    send(sim, 'p1', { type: 'haircut', hair: 14, hairColor: a.hairColor, beard: a.beard });
+    expect(sim.world.purse).toBe(purse - 15);
+    sitChair(sim, 'p1');
+    send(sim, 'p1', { type: 'haircut', hair: 14, hairColor: 7, beard: a.beard });
+    expect(sim.world.purse).toBe(purse - 25);
