+describe('le salon de Solange (T10-08 à T10-10)', () => {
+  function salon(day = TUESDAY, minutes = 10 * H): Sim {
+    const sim = town(day, minutes);
+    for (const c of sim.world.characters) placeCharacter(sim, c, at(sim, 'salon_inside'));
+    walk(sim, {}, 0.1);
