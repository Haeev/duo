{
  // Processus principal, code partagé, tests unitaires et configuration des outils: Node.
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@duo/config/tsconfig.node.json",
  "compilerOptions": {
    // `@duo/liaison` expose ses sources avec des imports en `.ts` (exécutables par Node tels quels).
    "allowImportingTsExtensions": true
  },
  "include": ["src/main", "src/shared", "tests/unit", "*.config.ts"]
}
