{
  "name": "duo",
  "productName": "Duo",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Application de bureau Duo: lanceur, salon et hébergement des jeux à deux (Electron).",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:test": "electron-vite build --mode test",
    "start": "electron-vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.e2e.json && tsc --noEmit -p scripts/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dist:mac": "electron-builder --config electron-builder.config.mjs --mac --publish never",
    "dist:win": "electron-builder --config electron-builder.config.mjs --win --publish never",
    "dist:linux": "electron-builder --config electron-builder.config.mjs --linux --publish never"
  },
  "devDependencies": {
    "@duo/config": "workspace:*",
    "@duo/liaison": "workspace:*",
    "@duo/paquet": "workspace:*",
    "@duo/protocol": "workspace:*",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/jost": "5.3.0",
    "@playwright/test": "catalog:",
    "@preact/signals": "catalog:",
    "@types/node": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electron-vite": "catalog:",
    "eslint": "catalog:",
    "preact": "catalog:",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
