{
  "name": "@duo/config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Configurations partagées du dépôt Duo: TypeScript, ESLint, Vitest, Prettier.",
  "exports": {
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./tsconfig.node.json": "./tsconfig.node.json",
    "./tsconfig.browser.json": "./tsconfig.browser.json",
    "./eslint": {
      "types": "./types/eslint.d.ts",
      "default": "./eslint.js"
    },
    "./vitest": {
      "types": "./types/vitest.d.ts",
      "default": "./vitest.js"
    },
    "./prettier": {
      "types": "./types/prettier.d.ts",
      "default": "./prettier.js"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "catalog:",
    "@eslint/js": "catalog:",
    "globals": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "peerDependencies": {
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
