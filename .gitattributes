# Fins de ligne LF partout, y compris sous Windows (ADR 0002).
* text=auto eol=lf

# Scripts lancés par cmd.exe: CRLF obligatoire.
*.cmd text eol=crlf
*.bat text eol=crlf

# Fichiers binaires: ni conversion des fins de ligne ni fusion textuelle.
