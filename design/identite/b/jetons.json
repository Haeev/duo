{
  "meta": {
    "name": "Duo, identité visuelle, piste B « Étoile double »",
    "version": "1.0.0",
    "source": "design/identite/b/source/jetons.cjs",
    "rule": "chaque chemin donne le nom de la variable CSS: color.surface-raised vaut --color-surface-raised",
    "rem": "1rem vaut 16 px à la taille d'interface 100 %"
  },
  "tokens": {
    "color": {
      "bg": "#0E1126",
      "bg-glow": "#1A1F48",
      "surface": "#1A1F3D",
      "surface-raised": "#252B52",
      "hairline": "#2A3060",
      "line": "#3B4380",
      "outline": "#7178BB",
      "text": "#F3F1FA",
      "text-muted": "#A7ABD6",
      "text-disabled": "#6F74A3",
      "accent": "#FFC857",
      "accent-hover": "#FFD47A",
      "accent-pressed": "#F0B440",
      "on-accent": "#0E1126",
      "success": "#6BD69A",
      "error": "#FF6B81",
      "focus": "#F3F1FA",
      "scrim": "#0E1126B8",
      "shadow-1": "#090B1B",
      "shadow-2": "#070915",
      "shadow-3": "#05060F"
    },
    "player": {
      "orb": "#5CE1E6",
      "crescent": "#8D6CFF",
      "star": "#D4F27A",
      "sun": "#FC663F",
      "planet": "#E787B1",
      "comet": "#22B07D",
      "on": "#0E1126",
      "halo-opacity": "0.45"
    },
    "font": {
      "display": "'Jost Variable', 'Jost', system-ui, sans-serif",
      "text": "'DM Sans Variable', 'DM Sans', system-ui, sans-serif"
    },
    "type": {
      "display": {
        "family": "'Jost Variable', 'Jost', system-ui, sans-serif",
        "size": "3.5rem",
        "line-height": "3.75rem",
        "weight": "300",
        "tracking": "-0.01em"
      },
      "title-1": {
        "family": "'Jost Variable', 'Jost', system-ui, sans-serif",
        "size": "2.5rem",
        "line-height": "3rem",
        "weight": "300",
        "tracking": "0"
      },
      "title-2": {
        "family": "'Jost Variable', 'Jost', system-ui, sans-serif",
        "size": "1.875rem",
        "line-height": "2.25rem",
        "weight": "400",
        "tracking": "0"
      },
      "title-3": {
        "family": "'Jost Variable', 'Jost', system-ui, sans-serif",
        "size": "1.375rem",
        "line-height": "1.75rem",
        "weight": "500",
        "tracking": "0.01em"
      },
      "overline": {
        "family": "'Jost Variable', 'Jost', system-ui, sans-serif",
        "size": "0.875rem",
        "line-height": "1.125rem",
        "weight": "500",
        "tracking": "0.24em"
      },
      "body-large": {
        "family": "'DM Sans Variable', 'DM Sans', system-ui, sans-serif",
        "size": "1.125rem",
        "line-height": "1.75rem",
        "weight": "400",
        "tracking": "0"
      },
      "body": {
        "family": "'DM Sans Variable', 'DM Sans', system-ui, sans-serif",
        "size": "1rem",
        "line-height": "1.5rem",
        "weight": "400",
        "tracking": "0"
      },
      "label": {
        "family": "'DM Sans Variable', 'DM Sans', system-ui, sans-serif",
        "size": "1rem",
        "line-height": "1.25rem",
        "weight": "600",
        "tracking": "0"
      },
      "small": {
        "family": "'DM Sans Variable', 'DM Sans', system-ui, sans-serif",
        "size": "0.875rem",
        "line-height": "1.25rem",
        "weight": "500",
        "tracking": "0.01em"
      },
      "figure": {
        "family": "'Jost Variable', 'Jost', system-ui, sans-serif",
        "size": "3.5rem",
        "line-height": "3.5rem",
        "weight": "300",
        "tracking": "0.02em"
      },
      "countdown": {
        "family": "'Jost Variable', 'Jost', system-ui, sans-serif",
        "size": "10rem",
        "line-height": "10rem",
        "weight": "300",
        "tracking": "0"
      }
    },
    "space": {
      "1": "0.25rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "5": "1.25rem",
      "6": "1.5rem",
      "8": "2rem",
      "10": "2.5rem",
      "12": "3rem",
      "16": "4rem",
      "20": "5rem"
    },
    "radius": {
      "small": "0.5rem",
      "medium": "0.875rem",
      "large": "1.375rem",
      "pill": "999px"
    },
    "stroke": {
      "hairline": "1px",
      "component": "0.125rem",
      "focus": "0.1875rem",
      "focus-offset": "0.1875rem"
    },
    "elevation": {
      "1": "0 0 0 1px #2A3060, 0 0.125rem 0 0 #090B1B",
      "2": "0 0 0 1px #3B4380, 0 0.25rem 0 0 #070915",
      "3": "0 0 0 1px #3B4380, 0 0.5rem 0 0 #05060F"
    },
    "icon": {
      "size": "1.5rem",
      "size-large": "2rem",
      "size-small": "1.25rem",
      "stroke": "1.75",
      "stroke-small": "1.8"
    },
    "duration": {
      "fast": "150ms",
      "medium": "300ms",
      "slow": "600ms",
      "orbit": "4000ms",
      "twinkle": "3600ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.45, 0, 0.25, 1)",
      "enter": "cubic-bezier(0.2, 0, 0.2, 1)",
      "exit": "cubic-bezier(0.45, 0, 0.85, 0.5)"
    },
    "loops": {
      "state": "running"
    }
  },
  "variants": {
    "reduced-motion": {
      "selector": ":root[data-motion=\"reduced\"]",
      "tokens": {
        "duration": {
          "fast": "0ms",
          "medium": "0ms",
          "slow": "0ms",
          "orbit": "0ms",
          "twinkle": "0ms"
        },
        "loops": {
          "state": "paused"
        }
      }
    }
  }
}
