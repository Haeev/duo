    "a-dit": {
      "kind": "line",
      "speaker": "ambroise",
      "text": "« À l'heure, ou presque. » Le « presque » me gratte. Mais c'est ma devise, sous la bonne ligne. Bon.",
      "emote": null,
      "next": null
