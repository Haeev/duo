    "une-voix": {
      "kind": "line",
      "speaker": "achille",
      "text": "Une voix. Il m'en faut deux, et la même. J'attends l'autre, les yeux fermés.",
      "emote": null,
      "next": null
    },
    "desaccord": {
      "kind": "line",
      "speaker": "achille",
      "text": "Deux voix, deux avis. Mettez-vous d'accord, puis revenez me le dire. Elle attend depuis 1934, elle a le temps.",
      "emote": null,
