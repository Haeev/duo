    "b0": {
      "kind": "line",
      "speaker": "margot",
      "text": "Bonjour ! Paulin t'a dit non ? C'est sa façon de dire bonjour. Je traduis depuis quinze ans.",
      "emote": null,
      "next": "t0"
    },
    "t0": {
      "kind": "effects",
