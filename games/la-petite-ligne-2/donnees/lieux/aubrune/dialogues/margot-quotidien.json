    "b2": {
      "kind": "line",
      "speaker": "margot",
      "text": "Bonjour ! Odette m'a déjà tout raconté sur tout le monde. J'ai fait semblant de ne pas écouter. Je sais tout.",
      "emote": null,
      "next": "t2"
    },
    "t2": {
