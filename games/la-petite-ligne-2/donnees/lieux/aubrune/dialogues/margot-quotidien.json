    "b1": {
      "kind": "line",
      "speaker": "margot",
      "text": "Te voilà ! J'ai des graines, des œufs, et un mari qui boude un piquet de clôture. Par quoi je commence ?",
      "emote": null,
      "next": "t1"
    },
    "t1": {
