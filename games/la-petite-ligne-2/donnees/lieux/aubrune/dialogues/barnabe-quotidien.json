    },
    "b3": {
      "kind": "line",
      "speaker": "barnabe",
      "text": "Te voilà. J'ai fendu trois stères ce matin, et porté un oisillon sur un kilomètre. Le plus lourd, c'était l'oisillon: il fallait pas le serrer.",
      "emote": null,
      "next": "t3"
