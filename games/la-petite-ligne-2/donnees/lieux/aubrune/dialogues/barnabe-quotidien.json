    "pluie": {
      "kind": "line",
      "speaker": "barnabe",
      "text": "Il pleut. Les arbres boivent, je les laisse tranquilles. On ne dérange pas quelqu'un qui boit.",
      "emote": null,
      "next": null
    },
    "brume": {
      "kind": "line",
      "speaker": "barnabe",
      "text": "La brume dans les bois, c'est comme chanter dans une église: tout résonne doux. J'en profite.",
      "emote": null,
      "next": null
    },
    "fournil": {
      "kind": "line",
      "speaker": "barnabe",
      "text": "Cinq heures, le fournil. Je pétris, Achille rêve debout. La pâte, c'est comme le bois vert: il ne faut pas la brusquer.",
      "emote": null,
      "next": null
    },
    "coupe": {
      "kind": "line",
      "speaker": "barnabe",
      "text": "Le jour, je suis à la coupe. Je chante un couplet par arbre. Les gros ont droit au refrain.",
      "emote": null,
      "next": null
    },
    "soir": {
      "kind": "line",
      "speaker": "barnabe",
      "text": "Le soir, je rentre à la forge. Mado tape encore. Je m'assois, j'écoute. Elle tape en mesure: on s'est mariés pour ça.",
      "emote": null,
      "next": null
    },
    "nuit": {
      "kind": "line",
      "speaker": "barnabe",
      "text": "La nuit, la forge craque en refroidissant. Mado dit que c'est le métal. Moi, je dis que la maison s'étire.",
      "emote": null,
