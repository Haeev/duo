    "b2": {
      "kind": "line",
      "speaker": "barnabe",
      "text": "Bonjour. Tu sens cette odeur de beurre chaud ? Non ? Moi non plus. Je ne sens rien. Je ne sais pas de quoi tu parles.",
      "emote": null,
      "next": "t2"
    },
    "t2": {
      "kind": "effects",
      "effects": [
        {
          "type": "remember",
          "key": "aubrune.tour.barnabe",
