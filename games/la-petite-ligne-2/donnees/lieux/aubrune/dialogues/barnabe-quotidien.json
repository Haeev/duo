    "b1": {
      "kind": "line",
      "speaker": "barnabe",
      "text": "Ah, les gardes ! Mado dit que vous êtes « pas trop [[duo:empotées|empotés]] ». Dans sa bouche, c'est une médaille.",
      "emote": null,
      "next": "t1"
    },
