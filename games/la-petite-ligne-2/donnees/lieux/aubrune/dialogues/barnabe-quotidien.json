    "b0": {
      "kind": "line",
      "speaker": "barnabe",
      "text": "Bonjour, bonjour. Je chantais. Je chante toujours en coupant: l'arbre tombe plus volontiers.",
      "emote": null,
      "next": "t0"
    },
    "t0": {
      "kind": "effects",
