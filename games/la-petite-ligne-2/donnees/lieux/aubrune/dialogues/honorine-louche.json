    "dit-meres": {
      "kind": "line",
      "speaker": "honorine",
      "text": "Les mères ! Odette va pleurer dans le sel, Colette dans le laurier. Elles accrocheront la louche à mi-chemin des deux cuisines.",
      "emote": "joy",
      "next": "fin"
    },
    "accord-moulin": {
      "kind": "effects",
      "effects": [
        {
          "type": "remember",
          "key": "aubrune.concours.laureate",
          "value": "moulin",
          "by": "duo"
        }
      ],
      "next": "dit-moulin"
    },
    "dit-moulin": {
      "kind": "line",
      "speaker": "honorine",
      "text": "La panade ! Berthe va le dire à sa meule avant de le dire aux gens. Odette et Colette seront d'accord pour bouder: c'est déjà ça.",
      "emote": "joy",
      "next": "fin"
    }
