    "pluie": {
      "kind": "line",
      "speaker": "paulin",
      "text": "Pluie. Bon pour les poireaux. Mauvais pour le foin. Je ne suis jamais content en entier. C'est un métier.",
      "emote": null,
      "next": null
    },
    "brume": {
      "kind": "line",
      "speaker": "paulin",
      "text": "Brume. On ne voit pas le bout du rang. Je sais où il est. Enfin. Je sais où il devrait être.",
      "emote": null,
      "next": null
    },
    "gue": {
      "kind": "line",
      "speaker": "paulin",
      "text": "Je ne bouge pas d'ici tant que le gué n'est pas refait. Non. Même pour manger. Margot m'apporte la soupe. C'est différent.",
      "emote": null,
      "next": null
    },
    "matin": {
      "kind": "line",
      "speaker": "paulin",
      "text": "Le matin, je suis aux champs. Je bine. Un rang, puis l'autre. Ne me demande pas si ça avance: ça pousse, c'est tout.",
      "emote": null,
      "next": null
    },
    "apres-midi": {
      "kind": "line",
      "speaker": "paulin",
      "text": "L'après-midi, je regarde lever ce que j'ai semé. Il ne se passe rien. C'est exactement ce qu'il faut.",
      "emote": null,
      "next": null
