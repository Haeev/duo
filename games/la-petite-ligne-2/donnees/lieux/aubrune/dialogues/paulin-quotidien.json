    "b2": {
      "kind": "line",
      "speaker": "paulin",
      "text": "Tu veux des graines ? Vois Margot. Moi, je les donnerais, et après on n'a plus de quoi semer.",
      "emote": null,
      "next": "t2"
    },
    "t2": {
