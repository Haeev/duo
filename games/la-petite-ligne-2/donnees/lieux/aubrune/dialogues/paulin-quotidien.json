    "b1": {
      "kind": "line",
      "speaker": "paulin",
      "text": "Bonjour. La terre est bonne, ici. Je ne le dirai pas deux fois: elle prendrait la grosse tête.",
      "emote": null,
      "next": "t1"
    },
    "t1": {
      "kind": "effects",
