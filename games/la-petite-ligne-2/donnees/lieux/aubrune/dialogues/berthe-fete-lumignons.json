    "nuit": {
      "kind": "line",
      "speaker": "berthe",
      "text": "Sur l'eau. Pour ma mère. Elle disait qu'une meunière ne quitte jamais son bief. Alors j'envoie la lumière voyager à sa place.",
      "emote": null,
