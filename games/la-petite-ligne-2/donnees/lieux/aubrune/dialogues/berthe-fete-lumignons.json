    "l3": {
      "kind": "line",
      "speaker": "berthe",
      "text": "Le mien, je le poserai sur l'eau, au ponton. Le courant l'emmènera vers l'aval. Le moulin est en amont: il ira voir du pays.",
      "emote": null,
      "next": null
