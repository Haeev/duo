    "l2": {
      "kind": "line",
      "speaker": "berthe",
      "text": "Ta moitié et toi, vous parlez en travaillant. C'est bien. Ma meule et moi, pareil. Sauf qu'elle, elle ne répond qu'en grinçant.",
      "emote": null,
      "next": null
