    "pluie": {
      "kind": "line",
      "speaker": "martial",
      "text": "Il pleut ! À vélo, chaque flaque est un baptême. J'ai été baptisé onze fois depuis ce matin.",
      "emote": null,
      "next": null
    },
    "brume": {
      "kind": "line",
      "speaker": "martial",
      "text": "Brume. Je roule à la sonnette: un coup tous les dix tours de pédale. Les brebis s'écartent. Les paroissiens, moins.",
      "emote": null,
      "next": null
    },
    "fanfare": {
      "kind": "line",
      "speaker": "martial",
      "text": "Le samedi, j'attends le train avec la grosse caisse. Un coup à l'entrée en gare, un coup au départ. Entre les deux, je la porte. Pénitence.",
      "emote": null,
      "next": null
    },
    "messe": {
      "kind": "line",
      "speaker": "martial",
      "text": "Dimanche: messe à dix heures. Sermon court, cantique long. On retient mieux ce qu'on chante que ce qu'on écoute.",
      "emote": null,
      "next": null
    },
    "aube": {
      "kind": "line",
      "speaker": "martial",
      "text": "À l'aube, j'ouvre l'église. Marthe arrive juste après. Elle vérifie que j'ai bien ouvert. J'ai toujours bien ouvert.",
      "emote": null,
      "next": null
    },
    "cimetiere": {
      "kind": "line",
      "speaker": "martial",
      "text": "Le matin, j'arrose au cimetière. Les fleurs d'abord. Puis je lis les noms à voix haute: personne n'aime qu'on oublie le sien.",
      "emote": null,
      "next": null
    },
    "tournee": {
      "kind": "line",
      "speaker": "martial",
      "text": "En matinée, je fais la tournée des écarts à vélo, jusqu'à la maison du bout. Personne n'y habite encore. Je sonne quand même.",
      "emote": null,
      "next": null
    },
    "cafe": {
      "kind": "line",
      "speaker": "martial",
      "text": "À midi, je déjeune chez Colette. Plat du jour, sans discuter. C'est la seule personne du bourg à qui j'obéis sans prier d'abord.",
      "emote": null,
      "next": null
    },
    "croix": {
      "kind": "line",
      "speaker": "martial",
      "text": "L'après-midi, je descends à la croix de chemin. La vieille route continuait, avant. Je m'assois, je regarde où elle allait.",
      "emote": null,
      "next": null
    },
    "place": {
      "kind": "line",
      "speaker": "martial",
      "text": "En fin de journée, je traverse la place en roue libre. On m'arrête six fois. C'est le but: un curé, ça se croise.",
      "emote": null,
      "next": null
    },
    "soir": {
      "kind": "line",
      "speaker": "martial",
      "text": "Le soir, je ferme l'église et je regonfle mes pneus. L'un nourrit l'âme, l'autre le mollet. Ne me demande pas lequel.",
      "emote": null,
      "next": null
    },
    "nuit": {
      "kind": "line",
      "speaker": "martial",
      "text": "Je dors au presbytère, le vélo dans le couloir. Il a sa place: on a fait trop de route ensemble pour qu'il couche dehors.",
      "emote": null,
      "next": null
    }
  }
