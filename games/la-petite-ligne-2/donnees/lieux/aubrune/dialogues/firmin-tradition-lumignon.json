        }
      ],
      "otherwise": "b-dit"
    },
    "b-dit": {
      "kind": "line",
      "speaker": "firmin",
      "text": "Pour ceux qui reviennent. Trente ans que j'attendais quelqu'un sur le quai. La flamme a tenu jusqu'à l'autorail. Je l'ai noté.",
      "emote": null,
      "next": null
    },
    "b-change": {
      "kind": "line",
      "speaker": "firmin",
      "text": "Ceux qui reviennent, cette année. Je n'ai pas fait campagne. J'ai seulement parlé fort près de Marthe. Ça ne compte pas.",
      "emote": null,
      "next": null
    }
  }
