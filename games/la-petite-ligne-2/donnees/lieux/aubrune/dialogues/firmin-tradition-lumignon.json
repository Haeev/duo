    "a-dit": {
      "kind": "line",
      "speaker": "firmin",
      "text": "Le lumignon a brûlé pour ceux qui partent. La coutume. J'ai pensé à ceux qui reviennent quand même: le règlement ne l'interdit pas.",
      "emote": null,
      "next": null
    },
    "a-change": {
      "kind": "line",
      "speaker": "firmin",
      "text": "Retour à ceux qui partent. Je respecte. Mais j'ai laissé la lanterne de la barrière allumée une minute de plus. Pour les autres.",
      "emote": null,
      "next": null
    },
    "b": {
      "kind": "branch",
      "cases": [
        {
          "when": [
            {
              "type": "decision_is",
              "decision": "lumignon-des-gardes",
              "state": "last",
              "option": "partent"
