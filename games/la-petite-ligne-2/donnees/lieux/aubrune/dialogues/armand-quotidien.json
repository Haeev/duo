    "matin": {
      "kind": "line",
      "speaker": "armand",
      "text": "Le matin, je fais classe. Au pupitre, je n'ai peur de rien. C'est en descendant de l'estrade que ça se gâte.",
      "emote": null,
      "next": null
    },
    "midi": {
      "kind": "line",
      "speaker": "armand",
      "text": "L'après-midi, leçon de choses dans la cour. Si tu as un insecte ou un fossile, je suis ton homme. Enfin, ton instituteur.",
      "emote": null,
      "next": null
    },
    "soir": {
      "kind": "line",
      "speaker": "armand",
      "text": "Le soir, je vais au lavoir. Les grenouilles chantent en mesure. Presque. Je bats la mesure quand personne ne regarde.",
