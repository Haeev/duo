    "b2": {
      "kind": "line",
      "speaker": "armand",
      "text": "Bonjour. Jeanne m'a demandé si les tunnels respirent. J'ai dit oui. Je crois que j'aurais dû dire « ça dépend ».",
      "emote": null,
      "next": "t2"
