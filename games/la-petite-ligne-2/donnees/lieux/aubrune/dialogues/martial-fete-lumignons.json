      "next": "l2"
    },
    "l2": {
      "kind": "line",
      "speaker": "martial",
      "text": "Ta moitié m'a demandé si c'était une fête religieuse. J'ai dit: c'est une fête. Le reste se discute en montée, pas un soir pareil.",
      "emote": null,
      "next": null
    },
