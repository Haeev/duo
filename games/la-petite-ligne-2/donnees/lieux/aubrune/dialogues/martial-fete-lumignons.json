    "nuit": {
      "kind": "line",
      "speaker": "martial",
      "text": "Au cimetière. Un seul, au milieu, pour tout le monde. Je ne connais pas encore les noms. Je les apprends. Il y a le temps.",
      "emote": null,
      "next": null
    }
