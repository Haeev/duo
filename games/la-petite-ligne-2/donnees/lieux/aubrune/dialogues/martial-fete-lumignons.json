    "l1": {
      "kind": "line",
      "speaker": "martial",
      "text": "Mes bouts de cierge finissent en lumignons. L'évêché n'a pas d'avis là-dessus: je n'ai pas posé la question. Vent arrière.",
      "emote": null,
      "next": null
    },
    "e2": {
      "kind": "effects",
