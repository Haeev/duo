      "next": "l3"
    },
    "l3": {
      "kind": "line",
      "speaker": "martial",
      "text": "Six clochers, six nuits d'été. Les cinq autres, on se couche tôt. Ici, on veille pour des gens qui ne sont pas là. Je reste.",
      "emote": null,
      "next": null
    },
