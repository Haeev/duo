  "priority": 35,
  "when": [
    {
      "type": "days_since",
      "key": "aubrune.barrieres.premier",
      "atLeast": 1,
      "atMost": 13
    },
    {
      "type": "not",
      "condition": {
        "type": "days_since",
        "key": "entendu.aubrune.leon-tradition-barriere",
        "of": "actor",
        "atMost": 13
      }
    }
  ],
  "once": null,
