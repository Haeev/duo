    },
    {
      "do": "say",
      "who": "narrator",
      "text": "Clac. Le bras s'incline, net. « Voie libre », annonce le signal, après trente ans de silence.",
      "emote": null,
      "sound": "Clac !",
      "to": "both",
      "seconds": null
    },
    {
      "do": "say",
      "who": "narrator",
      "text": "Reste le troisième levier. « NE PAS T..... ». Tu ne le touches pas. Tu es très [[fière|fier]] de toi.",
      "emote": null,
      "sound": null,
      "to": "a",
      "seconds": null
    },
    {
      "do": "say",
      "who": "narrator",
      "text": "Les mésanges inspectent leur nouveau rebord. Elles n'ont pas l'air de vouloir porter plainte.",
      "emote": null,
