    {
      "do": "say",
      "who": "narrator",
      "text": "Trois leviers. Les étiquettes ont déteint: « S.MA....E », « AIG...LE », « NE PAS T..... ».",
      "emote": null,
      "sound": null,
      "to": "a",
      "seconds": null
    },
    {
      "do": "say",
      "who": "narrator",
      "text": "D'ici, tu vois le bras du signal, l'aiguille à tes pieds, et un nid de mésanges sur le contrepoids.",
      "emote": null,
      "sound": null,
      "to": "b",
      "seconds": null
    },
    {
      "do": "say",
      "who": "narrator",
      "text": "Tu tires le premier levier. Demande à ta moitié ce qui bouge, dehors.",
      "emote": null,
      "sound": null,
      "to": "a",
      "seconds": null
    },
    {
      "do": "say",
      "who": "narrator",
      "text": "L'aiguille claque à tes pieds. Le signal, lui, ne bronche pas. Dis-le vite !",
      "emote": null,
      "sound": "Clac !",
      "to": "b",
      "seconds": null
    },
    {
      "do": "say",
      "who": "narrator",
      "text": "Le deuxième, alors. Il résiste. Tu tires des deux mains.",
      "emote": null,
      "sound": null,
      "to": "a",
      "seconds": null
    },
    {
      "do": "say",
      "who": "narrator",
      "text": "Le bras frémit, monte d'un cran, puis retombe. Le contrepoids est coincé par le nid. Préviens ta moitié.",
      "emote": null,
      "sound": null,
      "to": "b",
      "seconds": null
    },
    {
      "do": "await",
      "parts": [
        {
          "role": "a",
          "hint": "Tiens le levier, sans forcer.",
          "done": [
