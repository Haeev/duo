              "radius": 4
            }
          ]
        },
        {
          "role": "b",
          "hint": "Porte le nid à l'abri, sur le rebord du poste.",
          "done": [
            {
              "type": "reach",
              "point": "po",
              "who": "one",
              "radius": 4
            }
          ]
        }
