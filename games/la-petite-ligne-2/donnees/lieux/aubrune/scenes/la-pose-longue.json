    },
    {
      "do": "say",
      "who": "narrator",
      "text": "La lueur glisse au ras des rails, sans bruit. Elle met exactement douze secondes à passer la barrière.",
      "emote": null,
      "sound": null,
      "to": "both",
      "seconds": null
    },
    {
      "do": "say",
      "who": "narrator",
      "text": "Clac. Tu refermes. Tes doigts tremblent un peu. C'est le froid.",
