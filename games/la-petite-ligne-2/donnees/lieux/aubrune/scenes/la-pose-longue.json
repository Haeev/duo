      "to": "both",
      "seconds": null
    },
    {
      "do": "say",
      "who": "narrator",
      "text": "Tu ouvres l'obturateur. Ne le lâche pas avant le « top » de ta moitié.",
      "emote": null,
      "sound": null,
      "to": "a",
      "seconds": null
    },
    {
      "do": "say",
      "who": "narrator",
      "text": "Compte douze secondes, tout bas. À douze, dis « top ». Pas avant.",
      "emote": null,
      "sound": null,
