      "sound": null,
      "to": "b",
      "seconds": null
    },
    {
      "do": "say",
      "who": "lucie",
      "text": "Ha ! Ha ! Ha ! ... Pardon. Je ris. C'est rien. Je développe ça ce matin, sur la place. Ha !",
