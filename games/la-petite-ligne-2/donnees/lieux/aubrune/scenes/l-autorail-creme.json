    {
      "do": "say",
      "who": "anatole",
      "text": "Aubrune. Trente ans et quatre minutes de retard. On va encore dire que c'est ma faute.",
      "emote": "anger",
      "sound": null,
      "to": "both",
      "seconds": null
    },
    {
      "do": "say",
      "who": "anatole",
      "text": "Vos lettres d'embauche. ... Signature conforme. Tampon du jour.",
      "emote": null,
      "sound": "Clac ! Clac !",
      "to": "both",
      "seconds": null
    },
    {
      "do": "say",
      "who": "narrator",
      "text": "Il poinçonne ta lettre sans la regarder. Sa casquette est trop grande: tu ne vois pas ses yeux. Tu reconnais le poinçon.",
      "emote": null,
      "sound": null,
      "to": "a",
      "seconds": null
    },
    {
      "do": "say",
      "who": "narrator",
      "text": "Il poinçonne ta lettre sans la regarder. Par une fenêtre jaune, derrière lui: des banquettes. Tu connais ces banquettes.",
      "emote": null,
      "sound": null,
      "to": "b",
      "seconds": null
    },
    {
      "do": "say",
      "who": "anatole",
      "text": "Deux cartes de ligne. Un ordre de mission: siège de la Compagnie, Hautefonte, bureau 512.",
      "emote": null,
      "sound": null,
      "to": "both",
      "seconds": null
    },
    {
      "do": "say",
      "who": "anatole",
      "text": "Monsieur Lacombe vous y attend. Enfin, il attend.",
      "emote": null,
      "sound": null,
      "to": "both",
      "seconds": null
    },
    {
      "do": "say",
      "who": "anatole",
      "text": "Ce train repassera. À 5 h 12. Article premier: l'heure, c'est l'heure. Même trente ans après.",
      "emote": null,
      "sound": null,
      "to": "both",
      "seconds": null
    },
    {
      "do": "effects",
      "effects": [
        {
