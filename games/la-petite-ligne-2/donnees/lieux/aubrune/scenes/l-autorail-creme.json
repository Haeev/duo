    {
      "do": "say",
      "who": "narrator",
      "text": "Il remonte. L'autorail repart sans bruit, et la brume se referme. Dans ta main: une carte de ligne, tiède comme du pain.",
      "emote": null,
      "sound": null,
      "to": "both",
      "seconds": null
