      "to": "both",
      "seconds": null
    },
    {
      "do": "say",
      "who": "narrator",
      "text": "Sous ta main, un anneau de fer. Une trappe. Sur aucun plan.",
      "emote": null,
      "sound": null,
      "to": "a",
      "seconds": null
    },
    {
      "do": "say",
      "who": "narrator",
      "text": "Dans le rond de ta lampe: une échelle de meunier, aux marches usées en leur milieu. On est beaucoup descendu ici.",
      "emote": null,
      "sound": null,
      "to": "b",
      "seconds": null
