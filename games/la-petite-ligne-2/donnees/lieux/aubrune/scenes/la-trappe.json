      "seconds": null
    },
    {
      "do": "say",
      "who": "basile",
      "text": "Pas sur le plan. Et pourtant.",
      "emote": null,
      "sound": null,
      "to": "both",
      "seconds": null
    },
    {
      "do": "say",
      "who": "narrator",
      "text": "En bas: une table, un tabouret, un gros registre, et une lanterne de garde. Il lui manque son verre.",
      "emote": null,
      "sound": null,
      "to": "both",
      "seconds": null
    },
    {
      "do": "say",
      "who": "narrator",
      "text": "Tu ouvres le registre. Une colonne par jour, des années de jours. Une seule ligne à chaque fois: « 5 h 12, passé. »",
      "emote": null,
      "sound": null,
      "to": "a",
      "seconds": null
    },
    {
      "do": "say",
      "who": "narrator",
      "text": "Tu éclaires la dernière page: après la nuit de la fermeture, les lignes continuent. Six semaines. D'une autre écriture.",
