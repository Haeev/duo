  "beats": [
    {
      "do": "say",
      "who": "narrator",
      "text": "Le soir est là, et tout Aubrune avec. Des lampions de la halte au bout du quai, une table, vingt voix. On vous fait une place.",
      "emote": null,
      "sound": null,
      "to": "both",
      "seconds": null
    },
    {
      "do": "say",
      "who": "firmin",
      "text": "Service de nuit, exceptionnel. Motif: les gardes. Asseyez-vous. C'est un ordre, et c'est le dernier de la journée.",
      "emote": null,
      "sound": null,
      "to": "both",
      "seconds": null
    },
    {
      "do": "say",
      "who": "narrator",
      "text": "Ambroise se pousse pour toi sur le banc. Il te glisse: « La pendule est juste. Grâce à vous. Ne le répète pas à Firmin. »",
      "emote": null,
      "sound": null,
      "to": "a",
      "seconds": null
    },
    {
      "do": "say",
      "who": "narrator",
      "text": "Honorine te garde une place contre elle. Elle te glisse: « Firmin a ri, tout à l'heure. Trente ans que je guettais ça. »",
      "emote": null,
      "sound": null,
      "to": "b",
      "seconds": null
    },
    {
      "do": "say",
      "who": "narrator",
      "text": "Ce qu'on vous a soufflé à l'oreille, dites-le-vous: sur ce quai, ce soir, tout se partage.",
      "emote": null,
      "sound": null,
      "to": "both",
      "seconds": null
    },
    {
      "do": "await",
      "parts": [
        {
          "role": "a",
          "hint": "Lève ton bol avec ta moitié: appuie.",
          "done": [],
          "gesture": {
            "type": "press"
          }
        },
        {
          "role": "b",
          "hint": "Lève ton bol avec ta moitié: appuie.",
          "done": [],
          "gesture": {
            "type": "press"
          }
        }
      ],
      "together": 0.5
    },
    {
      "do": "say",
      "who": "narrator",
      "text": "Tous les bols se lèvent avec les vôtres. La soupe d'Odette fume, la tarte de Colette attend son tour, et personne ne regarde l'heure.",
      "emote": null,
      "sound": "À la vôtre !",
      "to": "both",
      "seconds": null
    },
    {
      "do": "say",
      "who": "odette",
      "text": "Mangez ! Et emportez-en: une veillée, ça se finit le lendemain, au petit-déjeuner, en racontant qui a dit quoi.",
      "emote": "joy",
      "sound": null,
      "to": "both",
      "seconds": null
    },
    {
      "do": "say",
      "who": "firmin",
      "text": "Tous les samedis soir, désormais, le quai veille. Ce n'est pas au règlement. Je l'y ajouterai. Article dernier.",
      "emote": null,
      "sound": null,
      "to": "both",
      "seconds": null
    },
    {
