            "type": "hold",
            "seconds": 2
          }
        },
        {
          "role": "b",
          "hint": "Soulève en même temps que ta moitié: appuie et tiens.",
          "done": [],
          "gesture": {
            "type": "hold",
            "seconds": 2
          }
        }
      ],
      "together": 0.5
    },
    {
      "do": "say",
      "who": "narrator",
      "text": "Le trombone sort de l'eau en crachant un long jet de vase. Dans le pavillon, un goujon vous regarde, outré, puis saute.",
      "emote": null,
      "sound": "Pfouuu !",
      "to": "both",
      "seconds": null
    },
    {
      "do": "say",
      "who": "narrator",
      "text": "Sur la coulisse, gravé à la pointe: « Si tu lis ceci, c'est que je l'ai encore lâché. Fernand. »",
      "emote": null,
