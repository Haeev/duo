// GABARIT: un lieu. Un lieu est un dossier autonome: lieu.json, carte.json, puis habitants/,
// dialogues/, commerces/, quetes/ (un fichier par contenu, voir les autres gabarits).
// Créer: pnpm nouveau lieu <id>           -> donnees/lieux/<id>/lieu.json et carte.json
// Schéma: src/donnees/schemas/lieu.ts
{
  "schema": 1,
  // Identifiant = nom du dossier.
  "id": "exemple-lieu",
  "name": "Lieu d'exemple",
  "station": {
    // Points de la carte: où l'on descend du train, et le quai où il faut être deux pour monter.
    "arrival": "descente",
    "platform": "quai",
    "platformRadius": 3,
  },
  // Lieux reliés par le rail. Le lien s'écrit des deux côtés (ici, et dans le lieu.json de l'autre).
  "links": [],
  // Activités offertes ici (pêche, insectes...): selon le lieu.
  "activities": [],
  // Musiques de jour et de nuit: { "day": "...", "night": "..." }, ou null tant qu'elles manquent.
  "music": null,
  // Facultatif: coins de pêche (schéma src/donnees/schemas/peche.ts). Exemple:
  // "fishing": [{ "id": "etang", "area": { "x": 10, "y": 10, "w": 6, "h": 4 }, "shadows": 4,
  //               "table": [{ "catch": "goujon", "weight": 1 }] }]
  // "area": cases d'eau (à mettre aussi dans "blocked" de la carte); "shadows": ombres visibles
  // au plus (1 à 8); "table": poissons (commun/prises/, avec un bloc "fish") et poids de tirage.
  // Note de placement (facultative, ignorée du moteur): pourquoi ce lieu existe et est fait ainsi.
  // `pnpm pourquoi` liste ce qui n'en a pas (règle « cohérence du monde » de CLAUDE.md).
  "pourquoi": "Lieu d'exemple: sert de modèle.",
}
