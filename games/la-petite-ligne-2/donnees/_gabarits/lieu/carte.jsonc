// GABARIT: la carte d'un petit lieu, écrite à la main, en cases de 1 m (x vers l'est, y vers le sud).
// Schéma: src/donnees/schemas/lieu.ts (512 x 512 au plus).
// Un grand lieu ne s'écrit pas à la main: son plan vu du dessus est la source, et
// `node outils/plan-vers-lieu.ts <plan.json> <carte.json>` produit cette carte avec, en plus,
// le terrain, les zones, les verrous d'histoire, le graphe des chemins, les repères, les points
// d'intérêt, les bâtiments et le dehors (`outdoor`) au-dessus de l'annexe des intérieurs (ADR 0022).
{
  "schema": 1,
  "width": 24,
  "height": 24,
  // Zones où l'on ne marche pas (murs, eau, voie).
  "blocked": [{ "x": 0, "y": 0, "w": 24, "h": 2 }],
  // Facultatif, petit lieu seulement: le sol dessiné, une nature pour tout puis des rectangles peints
  // dans l'ordre (natures de `src/rendu/lieu/reglages-tuiles.ts`: "plancher", "tapis-de-couloir",
  // "vide" pour ne rien dessiner, "herbe"...). Absent: la plaque d'essai. Exemple d'intérieur clos:
  // lieux/train-de-nuit/carte.json (murs posés comme meubles solides, rien dans "blocked").
  // "floor": { "nature": "vide", "areas": [{ "x": 2, "y": 3, "w": 7, "h": 3, "nature": "plancher" }] },
  // Points nommés: la gare, les postes des habitants, les repères de quête.
  "points": {
    "descente": { "x": 12, "y": 5 },
    "quai": { "x": 12, "y": 4 },
  },
  // Meubles et éléments du décor posés ici: "type" = un fichier de commun/meubles/.
  // "rotation": quarts de tour (0 façade au sud, 1 à l'est, 2 au nord, 3 à l'ouest).
  // Champs facultatifs d'un meuble:
  //   "pourquoi": pourquoi il est là, dans ce sens (ignoré du moteur; `pnpm pourquoi` liste les oublis).
  //   "group": nom d'un ensemble. Une table et ses chaises portent le même "group": le repas spécial
  //   à deux est alors servi quand les deux joueurs sont assis sur deux meubles du groupe (deux
  //   meubles au moins, dont un à brique "sit", à 6 m au plus l'un de l'autre). Exemple:
  //   { "id": "table", "type": "table-a-manger", ..., "group": "repas" },
  //   { "id": "chaise-1", "type": "chaise", ..., "group": "repas" },
  //   { "id": "chaise-2", "type": "chaise", ..., "group": "repas" }
  "objects": [
    {
      "id": "banc-du-quai",
      "type": "banc",
      "x": 12,
      "y": 8.5,
      "rotation": 0,
      "pourquoi": "Sur le quai, face à la voie, pour attendre le train assis.",
    },
  ],
  // Objets ramassables posés au sol (facultatif, 40 au plus): "item" = un fichier de commun/objets/
  // (un sac s'y trouve aussi), "count" dans la pile permise. "respawnDaily": true le remet chaque
  // matin s'il a été ramassé; sans lui, une fois ramassé il ne revient pas. Position hors zone bloquée.
  "groundItems": [
    {
      "id": "pomme-tombee",
      "item": "pomme",
      "count": 1,
      "x": 10,
      "y": 10,
      "respawnDaily": true,
      "pourquoi": "Une pomme tombée du panier d'un voyageur, au bout du quai.",
    },
  ],
}
