// GABARIT: une suite de quêtes d'un lieu, en actes (chapters) et en étapes.
// Créer: pnpm nouveau quete <id> <lieu>   -> donnees/lieux/<lieu>/quetes/<id>.json
// Schéma: src/donnees/schemas/quete.ts; conditions et effets communs: src/donnees/schemas/regles.ts
// Moteur et vocabulaire complet: src/simulation/quetes/README.md
// Progression commune: une étape franchie par l'un l'est pour les deux.
{
  "schema": 1,
  // Identifiant unique dans tout le jeu (c'est aussi le nom du fichier).
  "id": "exemple-quete",
  // main: suite principale du lieu; side: secondaire; errand: petite demande (rare).
  "kind": "side",
  "title": "Une quête d'exemple",
  // Facultatif: cette suite est l'acte "act" d'une histoire plus longue, regroupée au carnet
  // (même "id" et même "title" pour toutes ses suites). Exemple:
  //   "saga": { "id": "aubrune", "title": "Aubrune", "act": 2 },
  // L'habitant qui la donne, ou null.
  "giver": "cheffe-de-gare",
  // Ce qui l'ouvre (toutes vraies). [] : ouverte dès l'arrivée dans le lieu.
  // Une suite peut aussi s'ouvrir par l'effet { "type": "open_quest", "quest": "..." } d'une autre.
  // Exemple: [{ "type": "quest_step", "quest": "le-train-de-5h12", "step": "premiere-nuit" }]
  "requires": [],
  // Les actes se jouent l'un après l'autre.
  "chapters": [
    {
      "id": "chapitre-1",
      "title": "Les pommes du quai",
      "steps": [
        {
          "id": "cueillir",
          // Ligne du carnet: quoi faire, en une phrase, au tutoiement. Accords: [[féminin|masculin]].
          "objective": "Cueille trois pommes pour la cheffe de gare.",
          // Repère du coup d'œil (touche G, 3 s): { "point": "<point de la carte>" },
          // { "villager": "<habitant>" } ou null.
          "target": { "villager": "cheffe-de-gare" },
          // Absent: l'étape suit la précédente de l'acte. []: ouverte dès le début de l'acte
          // (en parallèle). ["a", "b"]: après ces étapes de l'acte.
          "after": [],
          // Ce qui franchit l'étape (toutes vraies). Communes: remembered, item_in_bag, place_is,
          // time_is, bond_at_least, need_at_least, days_since, fact_at_least, all, any, not
          //   (faits: voir le gabarit de dialogue). Une étape lit directement les faits du
          //   moteur, contrôlés au chargement: pièce de logement finie
          //   { "type": "remembered", "key": "<lieu>.<logement>.<pièce>", "equals": "restored" },
          //   palier de confort "<lieu>.<logement>.confort-<n>", décision "decisions.<id>",
          //   premier achat "commerces.<commerce>.premier-achat" (avec "of"), total vendu
          //   "ventes.<commerce>.<objet>" (fact_at_least). De l'histoire:
          //   { "type": "deliver", "item": "pomme", "count": 3, "villager": "cheffe-de-gare" }
          //       (on lui parle en les tenant: elles lui sont remises)
          //   { "type": "reach", "point": "quai", "who": "one" }   (ou "both"; "radius" en m)
          //   { "type": "talked", "dialogue": "accueil", "node": "fin" }   (node facultatif)
          //   { "type": "together" }   { "type": "scene_seen", "scene": "..." }
          //   { "type": "posture", "posture": "sleep", "who": "both" }   (assis: "sit"; "one" ou "both")
          //   { "type": "quest_step", "quest": "...", "step": "..." }
          // Décision à deux: l'étape la déclare et attend l'accord des deux joueurs.
          //   "decision": { "id": "<décision>", "options": ["<a>", "<b>"] },   (à côté de "done")
          //   "done": [{ "type": "decision_is", "decision": "<décision>", "state": "agreed" }]
          //   Chacun choisit dans un dialogue du lieu (voir le gabarit de dialogue, effet "choose").
          //   Tradition rejouée: "reopens": ["<événement du lieu>"] dans "decision". À chaque
          //   début de l'événement (chaque année), elle se rouvre; l'an dernier se lit par
          //   { "type": "decision_is", "decision": "<décision>", "state": "last", "option": "<a>" }.
          //   Son dialogue: "when" avec { "type": "not", "condition": { "type": "decision_is",
          //   "decision": "<décision>", "state": "agreed" } } pour se taire une fois l'accord pris.
          // Une fête: { "type": "event_is", "events": ["<événement>"], "when": "begun" } (gabarit d'événement).
          "done": [
            { "type": "deliver", "item": "pomme", "count": 3, "villager": "cheffe-de-gare" },
          ],
          // true: il faut être deux, réunis (sinon faisable seul).
          "together": false,
          // Effets à l'ouverture de l'étape, puis quand elle est franchie. Communs: remember,
          // give_item, take_item, give_money, change_need, give_bag. De l'histoire:
          //   { "type": "unlock_zone", "zone": "riviere" }
          //   { "type": "villager_arrives", "villager": "..." }
          //   { "type": "open_quest", "quest": "..." }   { "type": "play_scene", "scene": "..." }
          //   { "type": "travel_to", "place": "...", "ending": {...} }   (voir le gabarit de scène)
          //   Heure d'arrivée du trajet, facultative (sans elle: `travel.clockHours` de reglages.json):
          //   "arrival": { "kind": "hours", "hours": 3 }                  le trajet prend 3 h de jeu
          //   "arrival": { "kind": "at", "minute": 600 }                  arrivée à la prochaine 10 h
          //   "arrival": { "kind": "night", "minute": 480, "wakeAt": 85 } train de nuit: arrivée le
          //     lendemain à 8 h (heure après l'aube); la nuit se passe à bord comme dans un lit
          //     (sommeil remonté à wakeAt, faim et hygiène d'une nuit), sauf si on a déjà dormi.
          // Et aussi: take_money, change_bond, et "to": "duo" (voir le gabarit de dialogue).
          // Récompenses qui ne sont pas des objets, acquises au duo et annoncées aux deux:
          //   { "type": "give_recipe", "recipe": "<recette à apprendre>" }
          //   { "type": "give_plan", "plan": "<plan à apprendre>" }
          //   { "type": "give_entry", "entry": "<entrée de collection>" }   (carte postale, musique)
          //   { "type": "give_piece", "piece": "<pièce de tenue à gagner>" }   (étiquette "a-gagner")
          //   { "type": "adopt_animal", "species": "<espèce>", "name": "<nom>", "shelter": "<abri de la carte>" }
          "onStart": [],
          "onDone": [
            {
              "type": "remember",
              "key": "essai-gare.pommes-cueillies",
              "value": true,
              "by": "duo",
            },
          ],
        },
        {
          "id": "au-quai",
          "objective": "Retrouve l'autre sur le quai.",
          "target": { "point": "quai" },
          "done": [{ "type": "reach", "point": "quai", "who": "both" }],
          "together": true,
          "onStart": [],
          "onDone": [],
        },
      ],
    },
  ],
}
