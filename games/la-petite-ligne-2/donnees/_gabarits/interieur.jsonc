// GABARIT: un intérieur (pièce, boutique, étage) d'un lieu, sur la même grille que le dehors (ADR 0022).
// Créer: pnpm nouveau interieur <id> <lieu>   -> donnees/lieux/<lieu>/interieurs/<id>.json
// Schéma: src/donnees/schemas/lieu.ts (InteriorSchema)
// Il se pose hors du dehors (`outdoor` de carte.json), dans l'annexe sous la carte, à une case au
// moins de tout autre intérieur: le chargement l'entoure d'un mur. Coordonnées locales: (0, 0) est
// le coin nord-ouest de la pièce. Les identifiants des points, meubles et portes sont uniques dans
// tout le lieu: préfixe-les du nom de la pièce.
{
  "schema": 1,
  "id": "exemple-interieur",
  "name": "Nouvelle pièce",
  // Note de placement (facultative, ignorée du moteur): pourquoi cette pièce est ici et de cette taille.
  "pourquoi": "Pièce d'exemple.",
  // Taille en cases de 1 m, 64 au plus par côté.
  "width": 8,
  "height": 6,
  // Coin nord-ouest sur la grille du lieu: sous le dehors (y >= hauteur du dehors + 1).
  "at": { "x": 2, "y": 130 },
  // Murs intérieurs, cloisons, comptoirs fixes.
  "blocked": [],
  "points": {
    "piece-milieu": { "x": 4, "y": 3 },
  },
  // Meubles: { "id", "type", "x", "y", "rotation" }. Meuble conditionné (facultatif): il n'existe
  // (obstacle, cible, usage, dessin) que si toutes les conditions de "when" sont vraies, par
  // exemple une pièce de logement restaurée (fait `<lieu>.<logement>.<pièce>`):
  //   { "id": "piece-cuisiniere", "type": "cuisiniere", "x": 0.5, "y": 0.5, "rotation": 0,
  //     "when": [{ "type": "remembered", "key": "aubrune.maison-du-garde.cuisine" }] }
  // Un escalier ou une porte conditionné: "opens" et "says" de la porte (plus bas).
  "objects": [],
  // Chaque porte mène à une autre (« to »), qui ramène ici: écrire la porte du dehors dans
  // carte.json, au pied de la porte du bâtiment, avec "to" = l'identifiant de celle-ci.
  // « facing »: sens où l'on regarde en arrivant par cette porte (0 sud, 1 est, 2 nord, 3 ouest),
  // vers l'intérieur de la pièce. Champs facultatifs, qui ne règlent que ce sens-ci (on ressort
  // toujours): "enter": "act" (touche d'action sur "object", un meuble à brique passage; défaut
  // "walk", en marchant dessus), "opens": [conditions] (fermée à clé tant qu'elles sont fausses),
  // "shop": "<commerce du lieu>" (fermée hors de ses heures), "says": "phrase quand c'est fermé",
  // "width": largeur du passage en mètres (défaut 1) pour une porte plus large qu'une case.
  // La porte se pose sur la case contre son mur (ou sur une case de cloison, ou au milieu du sol
  // pour un escalier): le moteur en déduit le seuil, y dessine la porte et son paillasson, et la
  // rend visable. Garder 1,5 m libre devant elle, dans son axe (règle d'accès des tests).
  // Les verrous d'histoire de carte.json ont aussi leur "says" (« pas encore »).
  "doors": {
    "piece-porte": { "x": 4, "y": 5, "facing": 2, "to": "piece-porte-dehors" },
  },
}
