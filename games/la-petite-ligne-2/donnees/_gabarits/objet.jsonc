// GABARIT: un objet (tout ce qui tient dans une case du sac).
// Créer: pnpm nouveau objet <id>          -> donnees/commun/objets/<id>.json
// Schéma: src/donnees/schemas/objets.ts
{
  "schema": 1,
  // Identifiant = nom du fichier: minuscules, chiffres, traits d'union.
  "id": "exemple-objet",
  // Nom affiché, 40 caractères au plus.
  "name": "Objet d'exemple",
  // Modèle 3D: un `id` de `assets-src/objets/gabarits.toml` (ajouter l'entrée, puis lancer
  // `bash assets-src/objets/construire.sh`). Sans ce champ, le sac et la boutique montrent une
  // vignette générique marquée provisoire.
  "model": "pomme",
  // Famille: food, material, crop, catch, treasure, seed, supply, tool, furniture, clothing.
  // Les commerçants rachètent par famille.
  "family": "food",
  // Pile maximale dans une case (cahier 4.5: poisson 3, bûche 5, planche 10, outil 1).
  "stack": 5,
  // Se mange: points de faim rendus. Sinon: null.
  "food": { "hunger": 10 },
  // Outil: { "kind": "axe", "durability": 0, "gestureSeconds": 1, "bluntGestureSeconds": 1 }
  // (durability 0 = outil de base, inusable), avec "family": "tool" et "stack": 1. Sinon: null.
  // Travail d'un coup (facultatif, sans lui: niveau 0, 1 point, 1 case), dans "tool":
  // "work": { "tier": 0, "power": 6, "bluntPower": 4, "cells": 1, "bluntCells": 1,
  //   "upgrade": { "to": "hache-forgee", "cost": { "cents": 3000, "items": [] } },
  //   "repair": null }
  // tier: niveau (0 de base, 1 amélioré, 2 fin); power: points de travail par coup (le chêne en
  // demande 36); cells: cases du potager par coup (bêche, arrosoir); upgrade: amélioration à la
  // forge; repair: prix d'une réparation payée (null: ne se répare pas).
  "tool": null,
  // Repas spécial à deux (pile de 1, servi à table): ajouter "meal": { "perk": "no_tool_wear" }
  // (extra_catch, no_tool_wear, better_prices, night_rare_glow). Plat ordinaire: ne rien mettre.
}
