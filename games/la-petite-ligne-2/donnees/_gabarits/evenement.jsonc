// GABARIT: un événement du calendrier d'un lieu (fête de saison, visiteur du train, concours, anniversaire).
// Créer: pnpm nouveau evenement fete-des-barrieres aubrune   -> donnees/lieux/<lieu>/evenements/<id>.json
// Schéma: src/donnees/schemas/temps.ts. Moteur: src/simulation/monde/ (rien à y toucher).
{
  "schema": 1,
  "id": "exemple-evenement",
  "name": "Fête d'exemple",
  // festival, visitor, contest, birthday, market, other.
  "kind": "festival",
  // Date de l'année: { "type": "date", "season": "spring", "day": 3 } (jour de la saison, à partir de 1),
  // ou règle: { "type": "weekly", "weekday": "saturday", "seasons": [] } (seasons vide: toute l'année).
  "when": { "type": "date", "season": "summer", "day": 7 },
  // Nombre de jours, à partir de la date.
  "days": 1,
  // Heures de chaque jour, en minutes depuis minuit (cahier 4.7: 10 h à 22 h pour une fête).
  "hours": { "from": 600, "to": 1320 },
  // Conditions d'histoire (mêmes conditions que les dialogues); [] = toujours.
  "conditions": [],
  // Annoncé la veille (l'interface le montre avec la météo du lendemain).
  "announce": true,
  "activates": {
    // Faits écrits au début, au nom du duo (clé lieu.sujet.detail).
    "facts": [],
    // Habitants présents (de ce lieu, ou visiteurs venus par le train).
    "villagers": [],
    // Commerce spécial ouvert (commerces/<id>.json du lieu), ou null.
    "shop": null,
    // Scène jouée au début, ou null.
    "scene": null,
    // Air joué: entrée du carnet de source « tune » que les deux joueurs inscrivent, ou null.
    "tune": null,
  },
  // Facultatif: le train qui amène l'événement. Il s'arrête à « from », reste à quai jusqu'à
  // « to », puis repart (recette: src/simulation/monde/README.md, « Trains »). Pour en mettre un,
  // retire les « // » du bloc ci-dessous.
  // "train": {
  //   "pourquoi": "D'où il vient, où il s'arrête et pourquoi là (cohérence du monde).",
  //   // Véhicules de la tête (côté arrivée) à la queue: modèle du manifeste des décors, tampons
  //   // avant et arrière depuis le centre (m); "reversed": true pour un véhicule tourné.
  //   "consist": [{ "model": "railcar", "front": 7.26, "back": 7.26 }],
  //   // Voie: un tracé de « rails » de la carte; bouts « start » (premier point) ou « end ».
  //   "track": "ligne",
  //   "comesFrom": "start",
  //   "leavesTo": "start",
  //   // Le centre du véhicule « vehicle » (0: la tête) au droit d'un point de la carte, décalé de « shift » m.
  //   "stop": { "point": "quai", "vehicle": 0, "shift": 0 },
  //   // Freinage et démarrage: durée en minutes de jeu, distance en mètres.
  //   "arrival": { "minutes": 8, "distance": 100 },
  //   "departure": { "minutes": 8, "distance": 100 },
  // },
}
