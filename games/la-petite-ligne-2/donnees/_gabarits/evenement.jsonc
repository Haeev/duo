// GABARIT: un événement du calendrier d'un lieu (fête de saison, visiteur du train, concours, anniversaire).
// Créer: pnpm nouveau evenement fete-des-barrieres aubrune   -> donnees/lieux/<lieu>/evenements/<id>.json
// Schéma: src/donnees/schemas/temps.ts. Moteur: src/simulation/monde/ (rien à y toucher).
// Lire l'événement ailleurs (planning d'habitant, dialogue, déclencheur de scène, suite):
//   { "type": "event_is", "events": ["<id>"], "when": "begun" }
//   when: "on" (dans ses heures), "begun" (commencé aujourd'hui, jusqu'à l'aube suivante),
//         "today" (a lieu aujourd'hui), "tomorrow" (a lieu demain: ce qu'annonce la veille).
// Aucun fait à écrire au début ni à effacer le lendemain. Qui vient: une ligne de planning par
// habitant, avec cette condition; la scène d'ouverture: un déclencheur avec cette condition.
{
  "schema": 1,
  "id": "exemple-evenement",
  "name": "Fête d'exemple",
  // festival, visitor, contest, birthday, market, other.
  "kind": "festival",
  // Date de l'année: { "type": "date", "season": "spring", "day": 3 } (jour de la saison, à partir de 1),
  // ou règle: { "type": "weekly", "weekday": "saturday", "seasons": [] } (seasons vide: toute l'année).
  "when": { "type": "date", "season": "summer", "day": 7 },
  // Nombre de jours, à partir de la date.
  "days": 1,
  // Heures de chaque jour, en minutes depuis minuit (cahier 4.7: 10 h à 22 h pour une fête).
  "hours": { "from": 600, "to": 1320 },
  // Conditions d'histoire (mêmes conditions que les dialogues); [] = toujours. Elles peuvent citer
  // un autre événement (pas un jour de fête: { "type": "not", "condition": { "type": "event_is",
  // "events": ["<fête>"], "when": "today" } }), jamais en boucle (refusé au chargement).
  "conditions": [],
  // Annoncé la veille aux deux joueurs (l'interface le montre avec la météo du lendemain).
  "announce": true,
  "activates": {
    // Faits écrits au début, au nom du duo, pour un état qui dure au-delà de la journée (clé lieu.sujet.detail).
    "facts": [],
    // Commerce spécial ouvert (commerces/<id>.json du lieu), ou null.
    "shop": null,
    // Air joué: entrée du carnet de source « tune » que les deux joueurs inscrivent, ou null.
    "tune": null,
  },
  // Facultatif: commerces fermés du début de l'événement à l'aube ("all", ou une liste d'identifiants).
  // Le commerçant le dit en fin de conversation s'il a la réplique "lines": { "closed": "..." }.
  "closes": { "shops": "all" },
}
