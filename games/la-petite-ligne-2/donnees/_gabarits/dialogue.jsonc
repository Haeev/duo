// GABARIT: un dialogue d'un habitant (un graphe de nœuds).
// Créer: pnpm nouveau dialogue <id> <lieu>   -> donnees/lieux/<lieu>/dialogues/<id>.json
// Schéma: src/donnees/schemas/dialogue.ts; conditions et effets: src/donnees/schemas/regles.ts
{
  "schema": 1,
  "id": "exemple-dialogue",
  // L'habitant à qui l'on parle (fichier du dossier habitants/ du même lieu).
  "villager": "cheffe-de-gare",
  // Parmi les dialogues dont "when" est vrai, le plus prioritaire est joué. À partir de 10
  // (DIALOGUES.pendingPriority), il a quelque chose à dire (histoire, quête, souvenir, première
  // rencontre): il passe avant la boutique au comptoir tenu et n'est pas suivi de l'offre de la
  // boutique. En dessous (0: quotidien), conversation ordinaire.
  "priority": 0,
  // Conditions, toutes vraies. Exemples:
  //   { "type": "remembered", "key": "essai-gare.besace", "equals": true }
  //   { "type": "need_at_least", "need": "hygiene", "value": 21 }
  //   { "type": "item_in_bag", "item": "pomme", "count": 3 }
  //   { "type": "time_is", "from": 360, "to": 720 }
  //   { "type": "money_at_least", "amount": 300 }   (la bourse de qui parle: 3,00 € au moins)
  //   { "type": "decision_is", "decision": "<décision>", "state": "agreed", "option": "<a>" }
  //       décision à deux: agreed (prise, sur "option" si elle est donnée), split (deux avis:
  //       inviter à se mettre d'accord), mine (qui parle a choisi), theirs (l'autre a choisi)
  "when": [],
  // "duo": une seule fois pour les deux; "player": une fois chacun; null: à volonté.
  "once": null,
  "start": "bonjour",
  "nodes": {
    // Réplique: 150 caractères au plus (trois lignes du bandeau). "speaker": un habitant ou "player".
    // "emote": surprise, question, joy, anger, sad, idea, ou null. "next": nœud suivant, null = fin.
    // "opens" (facultatif): un écran ouvert chez celui qui lit, une fois la réplique lue; le fermer
    //   passe au nœud suivant. Écrans: "character-editor" (l'éditeur de personnage). Exemple:
    //   donnees/lieux/train-de-nuit/dialogues/controleur-papiers.json (nœud "photo").
    "bonjour": {
      "kind": "line",
      "speaker": "cheffe-de-gare",
      "text": "Une pomme pour la route ?",
      "emote": "question",
      "next": "choix",
    },
    // Choix: 2 à 3 options, dont une au moins sans condition. Effets possibles:
    //   give_item, take_item, give_money, change_need, give_bag, remember,
    //   { "type": "reveal_look" }   (le personnage de qui parle sort de l'ombre: jusque-là, une
    //       silhouette sans traits ni tenue; "to": "duo" pour les deux)
    //   { "type": "take_money", "amount": 250 }   (paiement en centimes: 2,50 €)
    //   { "type": "change_bond", "villager": "cheffe-de-gare", "points": 20 }   (négatif: perte)
    // give_item, take_item, give_money et take_money prennent "to": "duo" pour s'appliquer à
    // chacun des deux joueurs (défaut: celui qui parle). Un échange impossible (poches pleines,
    // argent insuffisant, objet manquant) est refusé avec sa raison et le choix reste ouvert.
    "choix": {
      "kind": "choice",
      "options": [
        {
          "id": "oui",
          "text": "Volontiers !",
          "when": [],
          "effects": [{ "type": "give_item", "item": "pomme", "count": 1 }],
          "next": "merci",
        },
        { "id": "non", "text": "Non merci.", "when": [], "effects": [], "next": null },
      ],
    },
    "merci": {
      "kind": "line",
      "speaker": "cheffe-de-gare",
      "text": "Bon voyage !",
      "emote": "joy",
      "next": null,
    },
    // Décision à deux (déclarée par une étape de quête, champ "decision"): une option par choix,
    //   "effects": [{ "type": "choose", "decision": "<décision>", "option": "<a>" }], puis un nœud
    //   "branch" sur decision_is: agreed (la suite), split (« mettez-vous d'accord »), sinon
    //   (« j'attends l'autre »). Exemple: donnees/lieux/aubrune/dialogues/achille-decision.json.
    // Autres nœuds: { "kind": "branch", "cases": [{ "when": [...], "next": "..." }], "otherwise": "..." }
    //               { "kind": "effects", "effects": [...], "next": "...", "otherwise": "..." }
    //               ("otherwise", facultatif: nœud joué si l'échange est impossible, rien appliqué)
  },
}
