    "letters": [
      {
        "id": "coop_welcome",
        "day": 1,
        "title": "Bienvenue à la Halte d'Aubrune",
        "from": "La coopérative de la ligne",
        "text": "Bonjour à la nouvelle équipe de la Halte d'Aubrune ! La coopérative de la ligne vous souhaite la bienvenue. Voici 200 sous pour vos premiers pas, et notre première commande, à déposer dans la caisse du quai avant le départ du train, samedi prochain à 16 h: 12 radis, 3 laitues, 6 œufs, 10 planches. Ce que vous commandez au catalogue avant vendredi minuit arrive par le train. Bonne semaine !",
        "read": []
      },
      {
        "id": "basile_workbench",
        "day": 3,
        "title": "Un mot de Basile",
        "from": "Basile",
        "text": "L'établi de la scierie est ouvert. La hache est accrochée à côté. B.",
        "read": []
      },
      {
        "id": "coop_catalogue_reminder",
        "day": 6,
        "title": "Rappel de la coopérative",
        "from": "La coopérative de la ligne",
        "text": "Rappel: le catalogue ferme vendredi à minuit. Les rideaux font fureur à la ville, paraît-il.",
        "read": []
      },
      {
        "id": "coop_recap",
        "day": 8,
        "title": "La commande est partie",
        "from": "La coopérative de la ligne",
        "text": "La coopérative a reçu 4 lignes sur 4: 540 sous. Merci ! Les radis d'Aubrune ont fait sensation à la ville.",
        "read": []
      },
      {
        "id": "coop_vergers",
        "day": 8,
        "title": "La suite de la ligne",
        "from": "La coopérative de la ligne",
        "text": "Si la voie des Vergers est dégagée, le train montera jusque là-haut. Il paraît que les cerisiers attendent quelqu'un.",
        "read": []
      },
      {
        "id": "coop_order_2",
        "day": 8,
        "title": "La commande du samedi 15",
        "from": "La coopérative de la ligne",
        "text": "Merci pour ce premier train ! La coopérative passe déjà sa deuxième commande, à déposer dans la caisse du quai avant samedi 15 à 16 h: 15 carottes, 4 laitues, 8 œufs, 4 omelettes, 2 truites. Les carottes demandent quatre jours de pousse: ne tardez pas trop. Au catalogue, une nouveauté pour les soirées fraîches: le poêle à bois.",
        "read": []
      },
      {
        "id": "basile_handcar",
        "day": 9,
        "title": "Basile et la draisine",
        "from": "Basile",
        "text": "La remise est ouverte. Passez me voir devant, j'ai deux mots à dire à cette draisine. B.",
        "read": []
      }
