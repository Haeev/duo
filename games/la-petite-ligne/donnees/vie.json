      "lines": [
        { "by": "martial", "text": "Merci d'être venus, et à dimanche prochain." },
        { "by": "honorine", "text": "Vous avez prêché court, mon père. On vous en remercie." },
        { "by": "armand", "text": "Le sermon sur la patience tombait bien, avec ma classe." },
        { "by": "margot", "text": "Le chant du début était un peu haut pour moi." },
        { "by": "berthe", "text": "Il manquait une voix grave, comme toujours." },
        { "by": "marthe", "text": "J'ai sonné juste, cette fois. Vous avez entendu ?" },
        { "by": "ambroise", "text": "Onze heures trente et deux minutes. Le clocher retarde." },
        { "by": "leon", "text": "On peut aller jouer, maintenant ?" }
      ]
    },
