      "groups": [{ "who": ["mado"], "spots": [{ "x": 37.6, "y": 17.6, "cap": 215 }], "activity": "stand" }],
      "lines": []
    },
    {
      "id": "mass", "ref": "S11", "tier": "P0", "from": "10:30", "to": "11:30",
      "when": [{ "type": "weekday_is", "weekdays": ["sunday"] }],
      "cameFrom": { "points": ["church_nave"], "at": "10:30" },
      "groups": [
