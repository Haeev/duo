        { "by": "odette", "text": "Tu as encore de la farine sur le nez." },
        { "by": "achille", "text": "La couronne est pour toi. Ne dis rien." },
        { "by": "odette", "text": "Elle est encore chaude, celle-là." },
        { "by": "achille", "text": "Le four a bien tiré, ce matin." },
        { "by": "odette", "text": "Mets-les sur l'étagère du haut, mon chou." }
