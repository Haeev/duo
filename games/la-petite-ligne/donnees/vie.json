    {"id": "station_register", "ref": 3, "tier": "P1", "points": ["station_door"], "verb": "examine", "kind": "pages", "pick": "cycle", "label": "Feuilleter le registre de la halte", "clip": "look_up", "clipSeconds": 1.2, "sound": "journal-open", "lines": [{"text": "Samedi 29 : train à 10 h 02, un voyageur, trois colis (dont celui d'Ambroise). Soleil. F. L."}, {"text": "Samedi 22 : train à 10 h 00, deux voyageurs, des sacs de blé pour la minoterie (Paulin les a comptés deux fois). Nuageux. F. L."}, {"text": "Samedi 15 : train à 10 h 05, personne ne descend, un colis pour Solange (du fil, encore). Pluie. F. L."}, {"text": "Samedi 8 : train à 10 h 01, la fanfare de la coopérative monte avec ses instruments. On les a entendus jusqu'au pont. Soleil. F. L."}]},
    {"id": "quay_timetable", "ref": 27, "tier": "P1", "points": ["station_door"], "verb": "examine", "kind": "pages", "pick": "week", "label": "Lire l'horaire de la halte", "clip": "look_up", "clipSeconds": 1.0, "sound": "journal-open", "lines": [{"text": "Horaire du samedi : arrivée 10 h. Au crayon, de la main de Firmin : « Samedi : fanfare de la coopérative. »"}, {"text": "Horaire du samedi : arrivée 10 h. Au crayon : « Samedi : les sacs de blé de Paulin partent par ce train. »"}, {"text": "Horaire du samedi : arrivée 10 h. Au crayon : « Samedi : Mado attend ses barres de fer. »"}, {"text": "Horaire du samedi : arrivée 10 h. Au crayon : « Samedi : colis pour Ambroise, fragile. »"}]},
