    {"id": "well_peek", "ref": 1, "tier": "P0", "points": ["well", "well_shelter"], "verb": "act", "label": "Se pencher sur le puits", "clip": "pickup", "clipSeconds": 1.0, "event": "well_peek", "cooldownSeconds": 2, "lines": [{"text": "Ton reflet a l'air content.", "when": [{"type": "time_is", "from": "05:00", "to": "21:00"}]}, {"text": "Tout au fond, ton reflet te fait un clin d'œil.", "when": [{"type": "time_is", "from": "05:00", "to": "21:00"}]}, {"text": "L'eau est loin, mais elle brille.", "when": [{"type": "time_is", "from": "05:00", "to": "21:00"}]}, {"text": "Une goutte tombe. Tu l'entends longtemps.", "when": [{"type": "time_is", "from": "05:00", "to": "21:00"}]}, {"text": "La lune est tombée dedans.", "when": [{"type": "any", "conditions": [{"type": "time_is", "from": "21:00", "to": "24:00"}, {"type": "time_is", "from": "00:00", "to": "05:00"}]}]}, {"text": "Le puits garde un morceau de nuit.", "when": [{"type": "any", "conditions": [{"type": "time_is", "from": "21:00", "to": "24:00"}, {"type": "time_is", "from": "00:00", "to": "05:00"}]}]}, {"text": "Il y a des étoiles au fond, ce soir.", "when": [{"type": "any", "conditions": [{"type": "time_is", "from": "21:00", "to": "24:00"}, {"type": "time_is", "from": "00:00", "to": "05:00"}]}]}], "duo": {"windowSeconds": 3, "lines": [{"text": "Deux têtes dans le puits, deux reflets contents."}], "heart": 1, "memory": "Souvenir : « Deux têtes dans le puits »."}},
