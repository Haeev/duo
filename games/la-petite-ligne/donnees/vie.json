      ],
      "lines": [
        { "by": "armand", "text": "Un petit café après la messe, c'est presque une prière." },
        { "by": "ambroise", "text": "Le café de Colette est à l'heure, lui." },
        { "by": "margot", "text": "Je ne reste pas longtemps, les bêtes attendent." },
        { "by": "berthe", "text": "Tu dis ça tous les dimanches, Margot." },
        { "by": "armand", "text": "Qui a vu le chat ce matin ? Il dormait sur le muret." },
        { "by": "ambroise", "text": "Encore une tasse et je retourne à mes pendules." }
      ]
    },
    {
