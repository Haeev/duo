              "type": "if",
              "condition": { "type": "order_complete", "day": 8 },
              "then": [{ "type": "play_dialogue", "dialogue": "firmin_end_full" }],
              "else": [{ "type": "play_dialogue", "dialogue": "firmin_end_partial" }]
