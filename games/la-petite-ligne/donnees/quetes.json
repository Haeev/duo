          "objective": "Arroser ce qui est semé.",
          "conditions": [{ "type": "watered", "count": 1 }]
        },
        {
          "id": "harvest",
          "objective": "Récolter une culture mûre.",
          "conditions": [{ "type": "harvested", "count": 1 }]
        }
      ],
      "completionEffects": [{ "type": "set_flag", "flag": "grocer_buys" }],
      "completionText": "Les premiers radis d'Aubrune depuis vingt ans. Odette achète désormais vos récoltes."
    },
    {
      "id": "meet_village",
      "kind": "main",
      "tier": "P0",
      "title": "Les gens du bourg",
      "giver": "firmin",
      "start": { "byEffect": true },
      "steps": [
        {
          "id": "meet_all",
          "objective": "Faire connaissance avec Firmin, Odette, Basile et Jeanne.",
          "conditions": [
            { "type": "talked_to", "villager": "firmin", "label": "Firmin", "since": "game_start" },
            { "type": "talked_to", "villager": "odette", "label": "Odette", "since": "game_start" },
            { "type": "talked_to", "villager": "basile", "label": "Basile", "since": "game_start" },
            { "type": "talked_to", "villager": "jeanne", "label": "Jeanne", "since": "game_start" }
          ]
        }
      ],
      "completionText": "Vous êtes d'ici, maintenant."
    },
    {
      "id": "saturday_order",
      "kind": "main",
      "tier": "P0",
      "title": "La commande du samedi",
      "giver": "firmin",
      "start": { "byEffect": true },
      "steps": [
        {
          "id": "fill_crate",
          "objective": "Déposer dans la caisse du quai avant samedi 16 h: {order}.",
          "conditions": [{ "type": "order_complete" }],
          "resolve": "at_deadline",
          "deadline": { "day": 8, "time": "16:00" },
          "onDeadline": [
            { "type": "pay_order" },
            { "type": "gather_players", "point": "quay_bell" },
            {
              "type": "if",
              "condition": { "type": "order_complete" },
              "then": [{ "type": "play_dialogue", "dialogue": "firmin_end_full" }],
              "else": [{ "type": "play_dialogue", "dialogue": "firmin_end_partial" }]
            },
            { "type": "play_dialogue", "dialogue": "firmin_end_vergers" },
            {
              "type": "if",
              "condition": { "type": "quest_done", "quest": "emile_riddle" },
              "then": [
                { "type": "play_dialogue", "dialogue": "firmin_end_key" },
                { "type": "set_world_state", "key": "handcar_shed", "value": "open" }
              ],
              "else": []
            },
            { "type": "send_letter", "letter": "coop_recap" },
            { "type": "send_letter", "letter": "coop_vergers" },
            { "type": "end_demo" }
          ]
        }
      ],
      "completionText": "Le train est parti avec votre commande."
    },
